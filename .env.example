# Cadus 2.0 -- self-host environment. Copy this file to `.env` and fill it in.
# `.env` is gitignored. Never commit a real secret. Docker Compose reads `.env`
# by itself. See docs/SELF_HOST.md.
#
# Compose reads `.env` for interpolation only. A key here reaches a container
# only when docker-compose.yml names it in that service's `environment:` block.
# If you add a key, forward it there too.

# ---- Required ---------------------------------------------------------------
# Where the site is served. There is no default: every `docker compose` command
# fails with `required variable SITE_ADDRESS is missing a value` until you set
# this key.
#   A real domain -> Caddy gets automatic HTTPS from Let's Encrypt. Point the
#   domain's DNS at this server and open ports 80 and 443.
#   :80           -> http only, for a test on a bare IP.
SITE_ADDRESS=math.example.com

# ---- Optional ---------------------------------------------------------------
# Log level for cadus-web and cadus-worker (the `tracing` env filter syntax).
# RUST_LOG=info

# ---- Not configurable here --------------------------------------------------
# The three database DSNs are fixed in docker-compose.yml, one per role, because
# the role split is the tenant-isolation control (C3), not a preference:
#   migrate -> postgresql://postgres@db:5432/cadus     superuser: DDL and roles
#   web     -> postgresql://cadus_app@db:5432/cadus    RLS applies, no UPDATE on events
#   worker  -> postgresql://cadus_admin@db:5432/cadus  BYPASSRLS for cross-tenant sweeps
# The database is on the private `backend` network with trust auth, so no DSN
# carries a password.
