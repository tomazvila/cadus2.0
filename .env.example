# Cadus 2.0 -- self-host environment. Copy this file to `.env` and fill it in.
# `.env` is gitignored. Never commit a real secret. Docker Compose reads `.env`
# by itself. See docs/SELF_HOST.md.
#
# Compose reads `.env` for interpolation only. A key here reaches a container
# only when docker-compose.yml names it in that service's `environment:` block.
# If you add a key, forward it there too.
#
# Every key in the "Required" block has no default. Each `docker compose`
# command fails with `required variable <KEY> is missing a value` until you set
# the key. A silent default is worse than a loud stop.

# ---- Required ---------------------------------------------------------------
# Where the site is served.
#   A real domain -> Caddy gets automatic HTTPS from Let's Encrypt. Point the
#   domain's DNS at this server and open ports 80 and 443. Example:
#   SITE_ADDRESS=math.example.com
#   :80           -> http only, for a test on a bare IP. This file ships `:80`,
#   so a copied file brings the stack up on http and reaches no ACME server.
SITE_ADDRESS=:80

# The three database passwords. Generate each one separately:
#
#   openssl rand -hex 24
# Rule: CADUS_APP_PASSWORD and CADUS_ADMIN_PASSWORD hold 16 to 128 characters of
# the set A-Z a-z 0-9 _ - only. cadus-migrate refuses any other value (exit 2)
# before it runs a statement, because the compose DSNs carry the raw value.
#
# Hex output is safe inside a DSN: it needs no percent-encoding. The stack puts
# these values into the three DSNs in docker-compose.yml.
#   POSTGRES_PASSWORD    -> the `postgres` superuser. The `migrate` one-shot
#                           uses it for DDL, extensions, and role changes.
#   CADUS_APP_PASSWORD   -> the `cadus_app` role. `cadus-web` connects with it.
#   CADUS_ADMIN_PASSWORD -> the `cadus_admin` role. `cadus-worker` connects
#                           with it.
# `cadus-migrate --admin-login` writes the last two into the two roles on every
# bring-up, so a changed value here reaches the database on the next
# `docker compose up -d`.
#
# WARNING: Do not rotate POSTGRES_PASSWORD in this file alone. The value is
# write-once. The `postgres:16` image reads it at initdb only, that is on the
# first start with an empty `db-data` volume. A new value here alone does NOT
# reach the database: the `db` container ignores it, `migrate` then fails to
# authenticate, and the site stays down. To rotate it, run
# `ALTER ROLE postgres PASSWORD ...` in the database first and change this file
# second. See "Rotate a password" in docs/SELF_HOST.md. Do not run
# `docker compose down -v` to recover: that deletes every learner row.
POSTGRES_PASSWORD=
CADUS_APP_PASSWORD=
CADUS_ADMIN_PASSWORD=

# ---- Optional ---------------------------------------------------------------
# Log level for cadus-web and cadus-worker (the `tracing` env filter syntax).
# RUST_LOG=info

# The HOST ports of the Caddy proxy. Defaults: 80 and 443. Caddy keeps ports 80
# and 443 inside the container, so the Caddyfile and SITE_ADDRESS do not change
# with these keys.
#
# Keep the defaults for a real site: Let's Encrypt reaches port 80 and port 443
# only, so a moved port gets no certificate. Move the ports for a test bring-up
# on a box where another stack already holds 80 and 443, and set
# SITE_ADDRESS=:80 for that bring-up. Example:
#   CADDY_HTTP_PORT=18080
#   CADDY_HTTPS_PORT=18443
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# ---- Not configurable here --------------------------------------------------
# The three database DSNs are built in docker-compose.yml, one per role, because
# the role split is the tenant-isolation control (C3), not a preference:
#   migrate -> postgresql://postgres:$POSTGRES_PASSWORD@db:5432/cadus
#              superuser: DDL, extensions, roles
#   web     -> postgresql://cadus_app:$CADUS_APP_PASSWORD@db:5432/cadus
#              RLS applies, no UPDATE on events
#   worker  -> postgresql://cadus_admin:$CADUS_ADMIN_PASSWORD@db:5432/cadus
#              BYPASSRLS for cross-tenant sweeps
# The database publishes no port and sits on the private `backend` network. The
# passwords are the second control: a container network is not an
# authentication boundary.
#
# CADUS_TEST_DATABASE_URL belongs to the development gate, not to the stack.
# `scripts/gate.sh` needs it. See README.md.

# Bound on every query, in milliseconds. 0 turns the bound off. A value that is
# not a whole number stops the process at start. The bound reaches the web and
# worker pools; cadus-migrate ignores it. A migration runs without a statement
# bound, because a migration takes as long as it takes, so docker-compose.yml
# does not forward this key to the `migrate` service.
DB_STATEMENT_TIMEOUT_MS=5000

# Client-side bound on every query, in milliseconds. 0 turns the bound off. The
# value is a whole number of milliseconds, like DB_STATEMENT_TIMEOUT_MS above.
# The bound reaches the web and worker pools; cadus-migrate ignores it.
#
# DB_STATEMENT_TIMEOUT_MS is the SERVER bound: Postgres cancels a statement that
# runs too long. DB_CLIENT_TIMEOUT_MS is the CLIENT bound: the caller stops
# waiting, so a lost socket that no firewall reports also ends the call. Keep
# this value above DB_STATEMENT_TIMEOUT_MS. The server then reports the timeout
# first, with the statement in the message, and the client bound is the backstop.
DB_CLIENT_TIMEOUT_MS=10000

# How long cadus-web takes to stop after SIGTERM, in seconds. This is ONE budget
# for the whole stop: the drain of the open requests gets it, and the pool close
# gets what is left of it, at least 1 s. Total stop time is this value plus 1 s
# or less, and docker-compose.yml gives the container a stop_grace_period of
# 20 s. Keep this value below 19.
# SHUTDOWN_DEADLINE_SECS=10

# The origin this deployment serves, as scheme://host with no path and no
# trailing slash. The CSRF origin layer of cadus-web compares the browser's
# `Origin` header against this string. Set it on every deployment that runs
# behind a proxy.
#
# With this key unset, the layer rebuilds the origin from `X-Forwarded-Proto`
# and `Host` instead, which is what 1.0 did. That fallback is correct only while
# the proxy sets `X-Forwarded-Proto`: drop the header and every https request
# rebuilds as `http://…`, so a genuine same-origin `Origin` stops matching and
# every browser write answers 403 cross_origin_rejected. Setting this key takes
# the check off the proxy header for good.
#
# A value with a path, a query, or a trailing slash matches no `Origin` header,
# so cadus-web EXITS 2 rather than refuse every write.
# PUBLIC_ORIGIN=https://tutor.example

# Local http:// development only. 0 (the default) serves the session cookie
# `__Host-cadus_session` with Secure, HttpOnly, SameSite=Lax, Path=/. 1 serves
# the plain name `cadus_session` without Secure, because a `__Host-` cookie
# cannot ride http:// — a browser discards it without a word, so the login
# appears to work and no session ever persists.
#
# The only values are 0 and 1. cadus-web EXITS 2 on anything else, so a typo
# such as `true` never falls back to a posture the operator did not ask for.
# CADUS_WEB_INSECURE_COOKIE=0

# The Argon2id parameter profile of the password hash (M5 U2, U4).
#
#   prod  time_cost 3, memory_cost 65536 KiB, parallelism 4  -- the default
#   test  time_cost 1, memory_cost 8192 KiB,  parallelism 1  -- the test suite
#
# The `test` profile is a CHEAP hash. Use it in a test run and never in a
# deployment. cadus-web EXITS 2 on any other value, so a typo never falls back
# to a profile the operator did not ask for.
# CADUS_AUTH_ARGON2_PROFILE=prod

# ---------------------------------------------------------------------------
# OAuth sign-in (M5 U5, specification section 3.1)
# ---------------------------------------------------------------------------
# A provider is served only when BOTH halves below are set AND the build
# installs a provider transport. This build installs none, so /api/auth/oauth
# answers 404 today and the four keys below are a placeholder. cadus-web writes
# one warn line at start when the keys are set and no transport is installed.
#
# The callback URL you register with the provider console is
# <origin>/api/auth/oauth/<provider>/callback, and it must match byte for byte.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# The external origin of the callback URL, as scheme://host. Unset, the service
# builds the origin the same way the CSRF layer does: X-Forwarded-Proto plus
# Host. Set it on every deployment behind a proxy, so a proxy that drops
# X-Forwarded-Proto does not send the provider an http:// callback.
# OAUTH_REDIRECT_BASE_URL=https://tutor.example

# Database in which `cadus-migrate --admin-login` takes the cluster-wide role lock.
# The migrate role must be able to connect to it. Default: postgres.
CADUS_MAINTENANCE_DB=postgres

# ---------------------------------------------------------------------------
# The diagnosis worker (A4, T4, T5, M5 U10)
# ---------------------------------------------------------------------------
# docker-compose.yml forwards these seven keys to the `worker` service and to no
# other service: a model call runs in cadus-worker and never on a request path
# (R4, L6).
#
# OPENAI_API_KEY is the switch. This file leaves it commented out, so a copied
# file calls no model: the worker runs the pool refill and leaves the diagnosis
# queue standing. That deployment costs prose and nothing else, because the
# verdict, the worked solution and the re-solve instruction are deterministic and
# already on the learner's screen (A3, L2).
#
# If you set the key, the other six keys below become binding. A bad value EXITS
# the worker 2, so a typo never falls back to a setting you did not ask for. Each
# key takes its default when you leave it blank. docs/SELF_HOST.md, section "The
# seven variables", holds the full table.
# OPENAI_API_KEY=

# The endpoint. Default: https://openrouter.ai/api/v1 (O2). A local
# OpenAI-compatible server, for example http://10.8.0.3:8080/v1, is the same code
# path. The `provider` and `reasoning` blocks reach the body only when the parsed
# host is exactly openrouter.ai.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# The model id the request names. Default: deepseek/deepseek-v4-pro (O2).
# OPENAI_MODEL=deepseek/deepseek-v4-pro

# The provider order, as a comma-separated list. T5 pins the order, so an
# openrouter.ai endpoint with an empty list EXITS the worker 2. A local endpoint
# ignores this key.
# OPENROUTER_PROVIDER_ORDER=deepseek,fireworks

# The output ceiling of one DIAGNOSIS call. Default: 600. This is a LATENCY
# bound, not a spend cap: O2 sets no spend cap.
# DIAGNOSIS_OUTPUT_TOKENS=600

# The reasoning ceiling of one DIAGNOSIS call (T5). Default: 600. A reasoning
# model shares its completion budget with its hidden reasoning, so a truncated
# reply repeats once with a 4x output ceiling.
# DIAGNOSIS_REASONING_MAX_TOKENS=600

# The output ceiling of one AUTHORING call. Default: 4000. An authored document
# is a whole template, teach page, hint ladder or distractor set, so it needs a
# wider budget than a diagnosis. The authoring pass is offline and no learner
# waits for it, so this is not a latency bound. `cadus-worker author` reads it;
# the diagnosis job never does.
# AUTHORING_OUTPUT_TOKENS=4000

# The reasoning ceiling of one AUTHORING call (T5). Default: 2000. The reasoning
# budget is part of the output budget, so this value keeps half of
# AUTHORING_OUTPUT_TOKENS for the document itself.
# AUTHORING_REASONING_MAX_TOKENS=2000

# The T4 call cap per session. Default: 0, and 0 is unlimited (O2). A cap that IS
# set never withholds the verdict: the job row goes to `capped` and the learner
# keeps the deterministic verdict and the stock re-solve instruction.
# DIAGNOSIS_CALLS_PER_SESSION=0

# The curriculum tree cadus-worker and cadus-web read (D-O4, A6, C5, M5 U6). The
# image carries the reviewed tree at /app/curriculum and sets this variable to
# that path, so a normal deployment sets nothing here. BOTH processes EXIT 2 when
# the tree does not load, and the message names the path and the first finding.
# Set this key only when a bind mount carries a different tree.
# CADUS_CURRICULUM=/app/curriculum
