  "query": "\n        UPDATE content_store\n        SET status = $2,\n            approved_by = COALESCE(approved_by, $3),\n            approved_at = COALESCE(approved_at, now())\n        WHERE digest = $1\n        RETURNING digest AS \"digest!\", status AS \"status!\", approved_by, approved_at\n        ",
