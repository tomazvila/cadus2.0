  "query": "\n        SELECT digest AS \"digest!\", kind AS \"kind!\", status AS \"status!\", body AS \"body!\"\n        FROM content_store\n        WHERE kp_id = $1\n          AND ((kind = $2 AND status IN ($3, $4))\n               OR (kind IN ($5, $6) AND status = $4))\n        ORDER BY kind, digest\n        ",
