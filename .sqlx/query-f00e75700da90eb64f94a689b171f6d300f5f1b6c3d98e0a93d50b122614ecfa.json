  "query": "\n        SELECT kp_id AS \"kp_id!\", kind AS \"kind!\", count(*) AS \"documents!\"\n        FROM content_store\n        WHERE status = 'approved'\n          AND approved_policy_digest IS NOT DISTINCT FROM ($1::jsonb ->> kp_id)\n        GROUP BY kp_id, kind\n        ",
