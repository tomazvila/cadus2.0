  "query": "\n        SELECT digest AS \"digest!\", body AS \"body!\"\n        FROM content_store\n        WHERE kp_id = $1 AND kind = $2 AND status = 'approved'\n          AND approved_policy_digest IS NOT DISTINCT FROM $3\n        ORDER BY approved_at DESC NULLS LAST, created_at DESC, digest\n        LIMIT 1\n        ",
