  "query": "\n            SELECT kp_id AS \"kp_id!\", digest AS \"digest!\", prompt_digest AS \"prompt_digest!\"\n              FROM content_store\n             WHERE kind = $1 AND status = $2\n               AND prompt_digest IS NOT NULL AND prompt_digest <> $3\n             ORDER BY kp_id, digest\n            ",
