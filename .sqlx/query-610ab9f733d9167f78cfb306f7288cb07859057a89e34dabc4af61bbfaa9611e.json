  "query": "\n        SELECT user_id AS \"user_id!\",\n               kp_id AS \"kp_id!\",\n               count(*) FILTER (WHERE claimed_at IS NULL) AS \"depth!\"\n        FROM serving_pool\n        GROUP BY user_id, kp_id\n        HAVING count(*) FILTER (WHERE claimed_at IS NULL) < $1\n        ORDER BY \"depth!\", user_id, kp_id\n        LIMIT $2\n        ",
