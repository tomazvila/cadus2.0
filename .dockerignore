# Keep the build context small and keep host state out of the image.

# The host build tree. The builder stage compiles from scratch inside the image;
# a host target/ is gigabytes and its artifacts do not match the image toolchain.
target

# Version control and agent state.
.git
.gitignore
.claude

# Frontend install output and build output. The `**/` prefix is load-bearing: a
# .dockerignore pattern is matched against the path RELATIVE TO THE CONTEXT ROOT,
# so a bare `node_modules` line excludes `./node_modules` and leaves
# `web/node_modules` in the context. The SPA install is the one that exists, it
# is hundreds of megabytes, and the image build makes its own with `npm ci`.
#
# `dist` is excluded for the same reason plus a sharper one: a stale host build
# copied over the image's own would ship a bundle nobody built here.
**/node_modules
web/dist

# The click-through's scratch trees and screenshots (M6 S13). `e2e/work` holds a
# full copy of `web/` per broken variant, so it is large and it is never input to
# an image.
web/e2e/work
web/e2e/shots

# Local environment and compose overrides never belong in the image.
.env
docker-compose.override.yml

# The toolchain file of the repository. The builder stage pins its own toolchain
# in the FROM line. rustup reads `rust-toolchain.toml` when it is in the build
# context, sees the channel `stable`, and downloads a second complete toolchain
# from static.rust-lang.org. Keep the file out and the image build needs no
# rustup egress.
rust-toolchain.toml
