# Cadus 2.0 reverse proxy. SITE_ADDRESS comes from .env:
#   a real domain (for example math.example.com) -> automatic HTTPS from
#                                                   Let's Encrypt. Open ports 80
#                                                   and 443 and point the DNS
#                                                   record at this server.
#   :80                                          -> http only, for a test on a
#                                                   bare IP. .env.example ships
#                                                   this value.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Operational endpoints stay off the internet. /api/ready runs one SELECT 1
	# through the web pool: it reports the datastore only. It reports nothing
	# about cadus-worker. Scrape it over the compose network (web:8080), never
	# through Caddy. /api/health stays reachable at the edge, so a 404 here
	# breaks no bring-up check.
	@ops path /api/ready /metrics /metrics/*
	handle @ops {
		respond 404
	}

	# Everything else goes to the web service. Caddy is the sole ingress and the
	# AUTHORITY on the client IP: OVERWRITE X-Forwarded-For with the real remote
	# address and discard what the client sent. A client then cannot spoof it to
	# evade the per-IP rate limits or to poison the access log. Do NOT write
	# `-X-Forwarded-For` here: that only deletes the header, and the app then
	# reads Caddy's own container IP for every request.
	handle {
		reverse_proxy web:8080 {
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}
}
