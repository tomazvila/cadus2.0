          "j": {
            "kind": "choice",
            "values": [
              "no"
            ]
          },
          "l": {
            "kind": "choice",
            "values": [
              "yes"
            ]
          }
        },
        "constraints": [],
        "hints": [
          "Substitute the point's first coordinate for x and its second for y.",
          "Compare the point's height with the boundary height at that x-coordinate."
        ],
        "solution_sketch": "The boundary height at $x={p}$ is $3({p})-11$. Compare ${q}$ with that height; a point below or on the boundary belongs to this inclusive lower half-plane.",
