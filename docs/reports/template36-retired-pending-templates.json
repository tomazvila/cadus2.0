    "body": {
      "kp_id": "compound-inequalities/kp1",
      "kind": "template",
      "arguments": {
        "statement": "Solve the three-part inequality ${a} <= 3x+5 < {b}$. Give interval notation.",
        "answer_expr": "[(a-5)/3,(b-5)/3)",
        "answer_contract": {
          "kind": "exact"
        },
        "params": {
