    "body": {
      "kp_id": "graphing-linear-inequalities/kp1",
      "kind": "template",
      "arguments": {
        "statement": "For $y {o} {a}x+7$, is the boundary line solid or dashed?",
        "answer_expr": "boundarystyle(o)",
        "answer_contract": {
          "kind": "label",
          "options": [
            [
              "dashed"
            ],
            [
              "solid"
            ]
          ]
        },
        "params": {
          "o": {
            "kind": "choice",
            "values": [
              "<",
              "<=",
              ">",
              ">="
            ]
          },
          "a": {
            "kind": "choice",
            "values": [
              -5,
              4,
              6
            ]
          }
        },
        "constraints": [],
        "hints": [
          "The boundary is obtained by replacing the comparison with equality.",
          "Decide whether points on that equality line belong to the solution region."
        ],
        "solution_sketch": "The boundary is $y={a}x+7$. Equality is allowed by an inclusive comparison, giving a solid line; a strict comparison excludes the line and uses a dashed line.",
        "distractors": [],
        "samples": [
          {
            "params": {
              "o": "<",
              "a": -5
            },
            "expected": "dashed"
          },
          {
            "params": {
              "o": "<",
              "a": 4
            },
            "expected": "dashed"
          },
          {
            "params": {
              "o": "<",
              "a": 6
            },
            "expected": "dashed"
          },
          {
            "params": {
              "o": "<=",
              "a": -5
            },
            "expected": "solid"
          },
          {
            "params": {
              "o": "<=",
              "a": 4
            },
            "expected": "solid"
          },
          {
            "params": {
              "o": "<=",
              "a": 6
            },
            "expected": "solid"
          },
          {
            "params": {
              "o": ">",
              "a": -5
            },
            "expected": "dashed"
          },
          {
            "params": {
              "o": ">",
              "a": 4
            },
            "expected": "dashed"
          },
          {
            "params": {
              "o": ">",
              "a": 6
            },
            "expected": "dashed"
          },
          {
            "params": {
              "o": ">=",
              "a": -5
            },
            "expected": "solid"
          },
          {
            "params": {
              "o": ">=",
              "a": 4
            },
            "expected": "solid"
          },
          {
            "params": {
              "o": ">=",
              "a": 6
            },
            "expected": "solid"
          }
        ]
      }
    }
