    "current_gate": {
      "code": "answer-contract",
      "message": "the supplied answer contract conflicts with the reviewed exemplar policy",
      "result": "refused"
    },
    "refusal_code": "answer-contract",
    "refusal": "the supplied answer contract conflicts with the reviewed exemplar policy",
    "retirement_reason": "the knowledge point's rewritten exemplars changed its answer contract, and the current gate refuses the template",
    "superseded_by": [
      "c8a84e32"
    ],
    "body": {
      "kp_id": "interpreting-graphs-qualitatively/kp1",
      "kind": "template",
      "arguments": {
        "statement": "A graph has time in hours on its horizontal axis and water depth in centimetres on its vertical axis. Its straight segment joins $(2,{a})$ to $(6,{b})$. Describe the depth by entering increasing and decreasing as yes/no fields. Both no means constant.",
        "answer_expr": "multipart(equalitylabel(signcase(b-a,[0,0,1]),1),equalitylabel(signcase(b-a,[1,0,0]),1))",
        "answer_contract": {
          "kind": "multipart",
          "parts": [
            {
              "name": "increasing",
              "contract": {
                "kind": "label",
                "options": [
                  [
                    "yes"
                  ],
                  [
                    "no"
                  ]
                ]
              }
            },
            {
              "name": "decreasing",
              "contract": {
                "kind": "label",
                "options": [
                  [
                    "yes"
                  ],
                  [
                    "no"
                  ]
                ]
              }
            }
          ]
        },
        "params": {
          "a": {
            "kind": "choice",
            "values": [
              11,
              17,
              23,
              29
            ]
          },
          "b": {
            "kind": "choice",
            "values": [
              17,
              23,
              29
            ]
          }
        },
        "constraints": [],
        "samples": [
          {
            "params": {
              "a": 11,
              "b": 17
            },
            "expected": "increasing = yes; decreasing = no"
          },
          {
            "params": {
              "a": 11,
              "b": 23
            },
            "expected": "increasing = yes; decreasing = no"
          },
          {
            "params": {
              "a": 11,
              "b": 29
            },
            "expected": "increasing = yes; decreasing = no"
          },
          {
            "params": {
              "a": 17,
              "b": 17
            },
            "expected": "increasing = no; decreasing = no"
          },
          {
            "params": {
              "a": 17,
              "b": 23
            },
            "expected": "increasing = yes; decreasing = no"
          },
          {
            "params": {
              "a": 17,
              "b": 29
            },
            "expected": "increasing = yes; decreasing = no"
          },
          {
            "params": {
              "a": 23,
              "b": 17
            },
            "expected": "increasing = no; decreasing = yes"
          },
          {
            "params": {
              "a": 23,
              "b": 23
            },
            "expected": "increasing = no; decreasing = no"
          },
          {
            "params": {
              "a": 23,
              "b": 29
            },
            "expected": "increasing = yes; decreasing = no"
          },
          {
            "params": {
              "a": 29,
              "b": 17
            },
            "expected": "increasing = no; decreasing = yes"
          },
          {
            "params": {
              "a": 29,
              "b": 23
            },
            "expected": "increasing = no; decreasing = yes"
          },
          {
            "params": {
              "a": 29,
              "b": 29
            },
            "expected": "increasing = no; decreasing = no"
          }
        ],
        "solution_sketch": "Time runs from 2 to 6, so read the endpoints left to right. Compare ending height {b} with starting height {a}. A higher ending height means increasing, a lower one means decreasing, and equal heights make the entire straight segment constant.",
        "hints": [
          "Read the graph from earlier time to later time.",
          "Compare the two vertical coordinates; horizontal movement alone says nothing about depth."
        ],
        "distractors": []
      }
    }
  }
