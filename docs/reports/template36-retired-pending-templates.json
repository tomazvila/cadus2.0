    "body": {
      "kp_id": "graphing-linear-inequalities/kp2",
      "kind": "template",
      "arguments": {
        "statement": "Does the point $({p},{q})$ belong to the shaded region $y <= 3x-11$? Answer {l} or {j}.",
        "answer_expr": "signcase(3*p-11-q,[j,l,l])",
        "answer_contract": {
          "kind": "label",
          "options": [
            [
              "yes"
            ],
            [
              "no"
            ]
          ]
        },
        "params": {
          "p": {
            "kind": "choice",
            "values": [
              -3,
              2,
              5
            ]
          },
          "q": {
            "kind": "choice",
            "values": [
              -20,
              -5,
              4,
              10
            ]
          },
          "j": {
            "kind": "choice",
            "values": [
              "no"
            ]
          },
          "l": {
            "kind": "choice",
            "values": [
              "yes"
            ]
          }
        },
        "constraints": [],
        "hints": [
          "Substitute the point's first coordinate for x and its second for y.",
          "Compare the point's height with the boundary height at that x-coordinate."
        ],
        "solution_sketch": "The boundary height at $x={p}$ is $3({p})-11$. Compare ${q}$ with that height; a point below or on the boundary belongs to this inclusive lower half-plane.",
        "distractors": [],
        "samples": [
