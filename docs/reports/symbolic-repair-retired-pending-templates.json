    "body": {
      "kp_id": "equations-special-cases/kp3",
      "kind": "template",
      "status": "pending",
      "body": {
        "v": 1,
        "topic_id": "equations-special-cases",
        "answer_kind": "expression",
        "answer_contract": {
          "kind": "label",
          "options": [
            [
              "one solution"
            ],
            [
              "no solution"
            ],
            [
              "all real numbers"
            ]
          ]
        },
        "statement": "Classify ${a}x+{b}={c}x+{d}$: one solution, no solution, or all real numbers.",
        "params": {
          "a": {
            "kind": "choice",
            "values": [
              -2,
              3
            ]
          },
          "b": {
            "kind": "choice",
            "values": [
              1,
              2
            ]
          },
          "c": {
            "kind": "choice",
            "values": [
              -2,
              3
            ]
          },
          "d": {
            "kind": "choice",
            "values": [
              1,
              2
            ]
          }
        },
        "constraints": [],
        "answer_expr": "linearclass((a,b),(c,d))",
        "solution_sketch": "Compare variable coefficients first. If ${a}$ and ${c}$ differ, one value solves the equation; if they match, equal constants give all real values and unequal constants give none.",
        "hints": [
          "After moving variable terms together, check whether a nonzero coefficient remains."
        ],
