{"arguments":{"answer_contract":{"kind":"multipart","parts":[{"contract":{"arity":3,"kind":"coordinates"},"name":"vertex_parameters"},{"contract":{"kind":"exact"},"name":"minimum"}]},"answer_expr":"multipart((a,-b/(2*a),7-b**2/(4*a)),7-b**2/(4*a))","constraints":[],"distractors":[],"hints":["Identify the structure first, then check each step by reversing it."],"params":{"a":{"kind":"choice","values":[2,3,4]},"b":{"kind":"choice","values":[8,12,16,20]}},"samples":[{"expected":"vertex_parameters = (2, -8/(2*2), 7-8**2/(4*2)); minimum = 7-8**2/(4*2)","params":{"a":2,"b":8}},{"expected":"vertex_parameters = (2, -12/(2*2), 7-12**2/(4*2)); minimum = 7-12**2/(4*2)","params":{"a":2,"b":12}},{"expected":"vertex_parameters = (2, -16/(2*2), 7-16**2/(4*2)); minimum = 7-16**2/(4*2)","params":{"a":2,"b":16}},{"expected":"vertex_parameters = (2, -20/(2*2), 7-20**2/(4*2)); minimum = 7-20**2/(4*2)","params":{"a":2,"b":20}},{"expected":"vertex_parameters = (3, -8/(2*3), 7-8**2/(4*3)); minimum = 7-8**2/(4*3)","params":{"a":3,"b":8}},{"expected":"vertex_parameters = (3, -12/(2*3), 7-12**2/(4*3)); minimum = 7-12**2/(4*3)","params":{"a":3,"b":12}},{"expected":"vertex_parameters = (3, -16/(2*3), 7-16**2/(4*3)); minimum = 7-16**2/(4*3)","params":{"a":3,"b":16}},{"expected":"vertex_parameters = (3, -20/(2*3), 7-20**2/(4*3)); minimum = 7-20**2/(4*3)","params":{"a":3,"b":20}},{"expected":"vertex_parameters = (4, -8/(2*4), 7-8**2/(4*4)); minimum = 7-8**2/(4*4)","params":{"a":4,"b":8}},{"expected":"vertex_parameters = (4, -12/(2*4), 7-12**2/(4*4)); minimum = 7-12**2/(4*4)","params":{"a":4,"b":12}},{"expected":"vertex_parameters = (4, -16/(2*4), 7-16**2/(4*4)); minimum = 7-16**2/(4*4)","params":{"a":4,"b":16}},{"expected":"vertex_parameters = (4, -20/(2*4), 7-20**2/(4*4)); minimum = 7-20**2/(4*4)","params":{"a":4,"b":20}}],"solution_sketch":"After factoring ${a}$ out of the variable terms, complete the inner square using ${b}/(2({a}))$. The compensation is $({b})^2/(4({a}))$, giving k equal to $