rs; c = all real numbers; d = all real numbers"},{"params":{"a":">","b":"<","c":"<","d":"<"},"expected":"a = all real numbers; b = no solution; c = no solution; d = no solution"},{"params":{"a":">","b":"<","c":"<","d":">"},"expected":"a = all real numbers; b = no solution; c = no solution; d = all real numbers"},{"params":{"a":">","b":"<","c":">","d":"<"},"expected":"a = all real numbers; b = no solution; c = all real numbers; d = no solution"},{"params":{"a":">","b":"<","c":">","d":">"},"expected":"a = all real numbers; b = no solution; c = all real numbers; d = all real numbers"},{"params":{"a":">","b":">","c":"<","d":"<"},"expected":"a = all real numbers; b = all real numbers; c = no solution; d = no solution"},{"params":{"a":">","b":">","c":"<","d":">"},"expected":"a = all real numbers; b = all real numbers; c = no solution; d = all real numbers"},{"params":{"a":">","b":">","c":">","d":"<"},"expected":"a = all real numbers; b = all real numbers; c = all real numbers; d = no solution"},{"params":{"a":">","b":">","c":">","d":">"},"expected":"a = all real numbers; b = all real numbers; c = all real numbers; d = all real numbers"}],"distractors":[],"solution_sketch":"Every absolute value is nonnegative. Each displayed right side is negative. A less-than comparison has no solution; a greater-than comparison holds for every real x. Apply that rule separately to all four comparisons.","hints":["Check the comparison sign and the boundary before writing each requested field."]}},{"kp_id":"comparing-integers/kp2","kind":"template","arguments":{"statement":"Judge ${a} < {b}$ as {t} or {f}, then arrange ${b}$, $0$, and ${a}$ from least to greatest with < signs. Answer judgment = ...; chain = ... .","answer_expr":"multipart(signcase(a-b,[t,f,f]),ascendingchain([a,b,0]))","answer_contract":{"kind":"multipart","parts":[{"name":"judgment","contract":{"kind":"label","options":[["true"],["false"]]}},{"name":"chain","contract":{"kind":"ascending_chain"}}]},"params":{"a":{"kind":"c