{"arguments":{"answer_contract":{"kind":"multipart","parts":[{"contract":{"kind":"label","options":[["true"],["false"]]},"name":"judgment"},{"contract":{"kind":"ascending_chain"},"name":"chain"}]},"answer_expr":"multipart(signcase(a-b,[t,f,f]),ascendingchain([a,b,0]))","constraints":[],"distractors":[],"hints":["A number farther left is smaller.","Compare signed values, then use one < sign between each pair in order."],"params":{"a":{"kind":"choice","values":[-11,-8,-5,2]},"b":{"kind":"choice","values":[-9,-3,4]},"f":{"kind":"choice","values":["false"]},"t":{"kind":"choice","values":["true"]}},"samples":[{"expected":"judgment = true; chain = -11 < -9 < 0","params":{"a":-11,"b":-9,"f":"false","t":"true"}},{"expected":"judgment = true; chain = -11 < -3 < 0","params":{"a":-11,"b":-3,"f":"false","t":"true"}},{"expected":"judgment = true; chain = -11 < 0 < 4","params":{"a":-11,"b":4,"f":"false","t":"true"}},{"expected":"judgment = false; chain = -9 < -8 < 0","params":{"a":-8,"b":-9,"f":"false","t":"true"}},{"expected":"judgment = true; chain = -8 < -3 < 0","params":{"a":-8,"b":-3,"f":"false","t":"true"}},{"expected":"judgment = true; chain = -8 < 0 < 4","params":{"a":-8,"b":4,"f":"false","t":"true"}},{"expected":"judgment = false; chain = -9 < -5 < 0","params":{"a":-5,"b":-9,"f":"false","t":"true"}},{"expected":"judgment = true; chain = -5 < -3 < 0","params":{"a":-5,"b":-3,"f":"false","t":"true"}},{"expected":"judgment = true; chain = -5 < 0 < 4","params":{"a":-5,"b":4,"f":"false","t":"true"}},{"expected":"judgment = false; chain = -9 < 0 < 2","params":{"a":2,"b":-9,"f":"false","t":"true"}},{"expected":"judgment = false; chain = -3 < 0 < 2","params":{"a":2,"b":-3,"f":"false","t":"true"}},{"expected":"judgment = true; chain = 0 < 2 < 4","params":{"a":2,"b":4,"f":"false","t":"true"}}],"solution_sketch":"Compare the locations of ${a}$ and ${b}$ on the number line for the judgment. Sort ${b}$, $0$, and ${a}$ by their signed values and connect consecutive values with <; every