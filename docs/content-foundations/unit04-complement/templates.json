          {
            "name": "proportional",
            "contract": {
              "kind": "label",
              "options": [
                [
                  "yes"
                ],
                [
                  "no"
                ]
              ]
            }
          }
        ]
      },
      "params": {
        "a": {
          "kind": "choice",
          "values": [
            3,
            6,
            9
