          "values": [
            5,
            10,
            15,
            20
          ]
        }
      },
      "constraints": [],
      "solution_sketch": "Compute ${a}/3$ and ${b}/5$. Compare cross-products $5*{a}$ and $3*{b}$; equality means one constant maps both inputs to their outputs.",
      "hints": [
