    "kp_id": "proportional-relationships/kp2",
    "kind": "template",
    "status": "pending",
    "arguments": {
      "statement": "A table contains $(3,{a})$ and $(5,{b})$. Give ratios=(first,second) in row order, then proportional=yes or no.",
      "answer_expr": "multipart((a/3,b/5),equalitylabel(5*a,3*b))",
      "answer_contract": {
