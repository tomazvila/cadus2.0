{"arguments":{"answer_expr":"(a+4)/5","constraints":[],"distractors":[],"hints":["Divide by 5. A nonzero remainder requires one more van."],"params":{"a":{"kind":"choice","values":[11,16,21,26,31,36,41,46,51,56,61,66]}},"samples":[{"expected":"3","params":{"a":11}},{"expected":"4","params":{"a":16}},{"expected":"5","params":{"a":21}},{"expected":"6","params":{"a":26}},{"expected":"7","params":{"a":31}},{"expected":"8","params":{"a":36}},{"expected":"9","params":{"a":41}},{"expected":"10","params":{"a":46}},{"expected":"11","params":{"a":51}},{"expected":"12","params":{"a":56}},{"expected":"13","params":{"a":61}},{"expected":"14","params":{"a":66}}],"solution_sketch":"Each value of {a} is one more than a multiple of 5, so the quotient must be rounded up to include one final van.","statement":"{a} students need vans that each hold 5 students. How many vans are required?"},"kind":"template","kp_id":"division-with-remainders/kp3"},
