    "kind": "template",
    "status": "pending",
    "arguments": {
      "statement": "For $x+5 {g} {a}$, give the boundary value and whether that boundary is included. Answer boundary = value; included = yes or no.",
      "answer_expr": "multipart(a-5,boundaryincluded(g))",
      "answer_contract": {
        "kind": "multipart",
        "parts": [
          {
            "name": "boundary",
            "contract": {
              "kind": "exact"
            }
          },
          {
            "name": "included",
            "contract": {
              "kind": "label",
              "options": [
                [
                  "yes"
                ],
                [
                  "no"
                ]
              ]
            }
          }
        ]
      },
      "params": {
        "a": {
          "kind": "choice",
          "values": [
            16,
            20,
            24,
            28,
            32,
            36
          ]
