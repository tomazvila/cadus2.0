{
  "status": "pending-independent-ai-review",
  "rows": [
    {
      "key": "checking-a-solution/kp1",
      "source_path": "whole-course-teach/drafts/part-02.json",
      "original_document_sha256": "6a2c5a8210c52a256b550496ff1fbe62e642a1e794f0617f20a1402c431763c3",
      "changed": true,
      "document": {
        "kp_id": "checking-a-solution/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "A candidate solves an equation when replacing every variable occurrence with that value makes the two sides equal. Evaluate each side separately, following the order of operations, then compare the results. Equal results mean yes; unequal results mean no.",
          "worked_example": {
            "problem": "Is $x=-4$ a solution of $6x+13=-9$? Answer yes or no.",
            "steps": [
              "Substitute on the left: $6(-4)+13=-24+13=-11$.",
              "The right side is $-9$.",
              "Since $-11$ and $-9$ are unequal, the answer is no."
            ]
          }
        }
      }
    },
    {
      "key": "checking-a-solution/kp2",
      "source_path": "whole-course-teach/drafts/part-02.json",
      "original_document_sha256": "68d1a95f7f3e02f3aff7b7c7534481102aa7f366872cae870f9815f7d9148c03",
      "changed": true,
      "document": {
        "kp_id": "checking-a-solution/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Substitute each candidate in turn; only one value makes both sides of the equation equal.",
          "worked_example": {
            "problem": "Which of $x=5$, $x=6$, or $x=7$ solves $8x-20=28$?",
            "steps": [
              "For $x=5$, the left side is $8(5)-20=20$.",
              "For $x=6$, it is $8(6)-20=28$.",
              "For $x=7$, it is $8(7)-20=36$.",
              "Only $x=6$ makes the sides equal."
            ]
          }
        }
      }
    },
    {
      "key": "addition-subtraction-equations/kp1",
      "source_path": "whole-course-teach/drafts/part-01.json",
      "original_document_sha256": "7dc820c61f8f43b9d50003c4ea114d43f3c6b7a373b3d72a7c3e3ff7492f0878",
      "changed": false,
      "document": {
        "kp_id": "addition-subtraction-equations/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "To solve x + a = b, subtract a from both sides to undo the addition and isolate x.",
          "worked_example": {
            "problem": "Solve $x + 23 = -5$.",
            "steps": [
              "Subtract 23 from both sides: $x = -5 - 23$.",
              "Compute: $x = -28$."
            ]
          }
        }
      }
    },
    {
      "key": "addition-subtraction-equations/kp2",
      "source_path": "whole-course-teach/drafts/part-01.json",
      "original_document_sha256": "834ca65e5108e89480bc29748e7d573baf7ef81e68943257dc61ce3c2a21bee8",
      "changed": false,
      "document": {
        "kp_id": "addition-subtraction-equations/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "To solve x - a = b, add a to both sides to undo the subtraction and isolate x.",
          "worked_example": {
            "problem": "Solve $x - 41 = -9$.",
            "steps": [
              "Add 41 to both sides: $x = -9 + 41$.",
              "Compute: $x = 32$."
            ]
          }
        }
      }
    },
    {
      "key": "one-step-equations/kp1",
      "source_path": "whole-course-teach/drafts/part-17.json",
      "original_document_sha256": "2c4bc75c987f68e1cc760a118ab61c9d1e8fccae799216bd5f50dcaa51b02441",
      "changed": true,
      "document": {
        "kp_id": "one-step-equations/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "A nonzero coefficient multiplies the unknown. Divide both sides by that coefficient to undo multiplication and isolate the unknown. Keep the divisor\u2019s sign and check by multiplying your result by the coefficient.",
          "worked_example": {
            "problem": "Solve $9x=-72$.",
            "steps": [
              "Divide both sides by nine: $x=-72/9$.",
              "Different signs give a negative quotient: $x=-8$.",
              "Check: $9(-8)=-72$."
            ]
          }
        }
      }
    },
    {
      "key": "one-step-equations/kp2",
      "source_path": "whole-course-teach/drafts/part-17.json",
      "original_document_sha256": "ba71d5b5ddf9feb00256df692ba7e513ed2e6006d32771fbe54afb2244394eb8",
      "changed": true,
      "document": {
        "kp_id": "one-step-equations/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "When the unknown is divided by a known nonzero number, multiply both sides by that divisor. This undoes the division and isolates the unknown. Include the divisor\u2019s sign, then substitute to check.",
          "worked_example": {
            "problem": "Solve $x/(-8)=-5$.",
            "steps": [
              "Multiply both sides by the divisor $-8$.",
              "This gives $x=(-5)(-8)=40$.",
              "Check: $40/(-8)=-5$."
            ]
          }
        }
      }
    },
    {
      "key": "one-step-equations/kp3",
      "source_path": "whole-course-teach/drafts/part-17.json",
      "original_document_sha256": "a2dce9e97486da64c3a7e8716da8d555647557827d81669785f1d5ecbade9788",
      "changed": true,
      "document": {
        "kp_id": "one-step-equations/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "Identify the operation applied to the unknown and undo it on both sides. Undo addition by subtraction, subtraction by addition, multiplication by a nonzero number through division, and division by a nonzero number through multiplication. Preserve signs and check the result.",
          "worked_example": {
            "problem": "Solve $y-9=-13$.",
            "steps": [
              "Undo subtraction by adding nine to both sides: $y=-13+9$.",
              "Combine the signed numbers: $y=-4$.",
              "Check: $-4-9=-13$."
            ]
          }
        }
      }
    },
    {
      "key": "two-step-equations/kp1",
      "source_path": "whole-course-teach/drafts/part-28.json",
      "original_document_sha256": "fc1c622fdf80d4901b52f2f947234e4368c4a25d1ee6204d834c0ace2bac5340",
      "changed": true,
      "document": {
        "kp_id": "two-step-equations/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "For ax+b=c with nonzero a, subtract the added constant b from both sides, then divide both sides by a. This reverses the operations applied to x. Check by substituting the result in the original equation.",
          "worked_example": {
            "problem": "Solve $6x+7=43$.",
            "steps": [
              "Subtract seven from both sides: $6x=36$.",
              "Divide both sides by six: $x=6$.",
              "Check: $6(6)+7=43$."
            ]
          }
        }
      }
    },
    {
      "key": "two-step-equations/kp2",
      "source_path": "whole-course-teach/drafts/part-28.json",
      "original_document_sha256": "ba2d475da1f1754b26ef29be73da89db00b7888bbb60e3310d60593fef75eff9",
      "changed": true,
      "document": {
        "kp_id": "two-step-equations/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "First undo any added or subtracted constant on both sides. If the remaining term multiplies the unknown by a nonzero coefficient, divide by that coefficient. If it divides the unknown by a nonzero number, multiply by that number. Preserve negative signs and check the original equation.",
          "worked_example": {
            "problem": "Solve $\\frac{x}{-5} + 3 = 10$.",
            "steps": [
              "Subtract $3$ from both sides: $\\frac{x}{-5} = 7$.",
              "Multiply both sides by $-5$: $x = 7 \\times (-5)$.",
              "Compute: $x = -35$.",
              "Check: $\\frac{-35}{-5} + 3 = 7 + 3 = 10$, which matches."
            ]
          }
        }
      }
    },
    {
      "key": "variables-both-sides/kp1",
      "source_path": "whole-course-teach/drafts/part-29.json",
      "original_document_sha256": "2bb97d99b6126d37eaf14553e07d37969b32a756ff0c285a3101ef005b25f6c8",
      "changed": true,
      "document": {
        "kp_id": "variables-both-sides/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "Subtract the variable term with the smaller coefficient from both sides, then combine the remaining variable terms. Undo the remaining constant operation and divide by the nonzero coefficient to isolate the unknown. Substitution into both original sides checks the solution.",
          "worked_example": {
            "problem": "Firm A charges $12x+30$ euros for $x$ days and firm B charges $6x+78$ euros for the same days. For how many days are the charges equal?",
            "steps": [
              "Set the charges equal: $12x+30=6x+78$.",
              "Subtract $6x$ from both sides: $6x+30=78$.",
              "Subtract thirty, then divide by six: $6x=48$, so $x=8$ days.",
              "Check both charges: $12(8)+30=126$ and $6(8)+78=126$ euros."
            ]
          }
        }
      }
    },
    {
      "key": "variables-both-sides/kp2",
      "source_path": "whole-course-teach/drafts/part-29.json",
      "original_document_sha256": "17244424cdc71a444c397687db19b15a0c38f149d3a6588f13644c48116981ed",
      "changed": true,
      "document": {
        "kp_id": "variables-both-sides/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Compare the signed coefficients of the variable. Subtract the term with the smaller coefficient from both sides; subtracting a negative term adds its opposite. This leaves a positive coefficient on the other side. Combine constants, divide, and check both original sides.",
          "worked_example": {
            "problem": "After $t$ hours, reservoir A holds $-4t+90$ thousand litres and reservoir B holds $-10t+150$ thousand litres. After how many hours are the volumes equal?",
            "steps": [
              "Set the volumes equal: $-4t+90=-10t+150$.",
              "The smaller coefficient is $-10$. Add $10t$ to both sides: $6t+90=150$.",
              "Subtract ninety and divide by six: $6t=60$, so $t=10$ hours.",
              "Check: $-4(10)+90=50$ and $-10(10)+150=50$ thousand litres."
            ]
          }
        }
      }
    },
    {
      "key": "distribute-then-solve/kp1",
      "source_path": "whole-course-teach/drafts/part-06.json",
      "original_document_sha256": "ebff0cea2b73967253836a66774758c254c2943fa5021e89f550c65066916771",
      "changed": true,
      "document": {
        "kp_id": "distribute-then-solve/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "A positive multiplier in front of parentheses multiplies every term inside them. Distribute first, then undo the addition and the multiplication in turn.",
          "worked_example": {
            "problem": "Solve $9(x-2)=45$ by distributing first.",
            "steps": [
              "Multiply both inside terms by nine: $9x-18=45$.",
              "Add eighteen to both sides: $9x=63$.",
              "Divide by nine: $x=7$.",
              "Check: $9(7-2)=9(5)=45$."
            ]
          }
        }
      }
    },
    {
      "key": "distribute-then-solve/kp2",
      "source_path": "whole-course-teach/drafts/part-06.json",
      "original_document_sha256": "7566193a3c032afd43c3dcb975c0ac18f3a68a48f9d8852353a6e19a81010b73",
      "changed": true,
      "document": {
        "kp_id": "distribute-then-solve/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Multiply every term inside the parentheses by the signed outside factor. A leading minus acts as negative one. Combine constants, then undo the constant operation and divide by the nonzero variable coefficient. Check all signs by substituting the result into the original equation.",
          "worked_example": {
            "problem": "Solve $-9(x-3)+4=-41$.",
            "steps": [
              "Distribute the signed factor: $-9x+27+4=-41$.",
              "Combine constants: $-9x+31=-41$.",
              "Subtract thirty-one: $-9x=-72$. Divide by negative nine: $x=8$.",
              "Check: $-9(8-3)+4=-45+4=-41$."
            ]
          }
        }
      }
    },
    {
      "key": "multi-step-equations/kp1",
      "source_path": "whole-course-teach/drafts/part-16.json",
      "original_document_sha256": "86210aff80762a8faf25279f21adde02886eb70db122c8c840430f0947500f4e",
      "changed": true,
      "document": {
        "kp_id": "multi-step-equations/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "Combine terms that have the same variable part by adding their signed coefficients. Combine constants separately. Then undo the constant operation and divide by the nonzero coefficient to isolate the unknown. Check in the original equation.",
          "worked_example": {
            "problem": "Solve $6x-2x-7=29$.",
            "steps": [
              "Combine variable terms: $4x-7=29$.",
              "Add seven to both sides: $4x=36$.",
              "Divide by four: $x=9$.",
              "Check: $6(9)-2(9)-7=54-18-7=29$."
            ]
          }
        }
      }
    },
    {
      "key": "multi-step-equations/kp2",
      "source_path": "whole-course-teach/drafts/part-16.json",
      "original_document_sha256": "d2c4c5bc8d20c48ea6629277715f0fb1035dd2ed216e5a074f5d29aab6c529c4",
      "changed": true,
      "document": {
        "kp_id": "multi-step-equations/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Distribute every outside factor to all terms in its parentheses, then combine like terms on each side. Collect variable terms on one side by applying the same subtraction to both sides. Collect constants, divide by the remaining nonzero coefficient, and check the original equation.",
          "worked_example": {
            "problem": "Solve $4(x-3)=3(x+2)+1$.",
            "steps": [
              "Distribute and combine: $4x-12=3x+7$.",
              "Subtract $3x$ from both sides: $x-12=7$.",
              "Add twelve: $x=19$.",
              "Check: $4(19-3)=64$ and $3(19+2)+1=64$."
            ]
          }
        }
      }
    },
    {
      "key": "multi-step-equations/kp3",
      "source_path": "whole-course-teach/drafts/part-16.json",
      "original_document_sha256": "a03324a818523ff5d950e273dee85ccdfaca982ea79af9076bb8f27d0004cae4",
      "changed": true,
      "document": {
        "kp_id": "multi-step-equations/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "Distribute first, preserving every sign. Combine like terms separately on each side, then collect variable terms on one side and constants on the other through equal operations on both sides. Divide by the remaining nonzero coefficient and verify in the original equation.",
          "worked_example": {
            "problem": "Solve $6(x-2)-2x=3(x+1)-5$.",
            "steps": [
              "Distribute: $6x-12-2x=3x+3-5$.",
              "Combine like terms on each side: $4x-12=3x-2$.",
              "Subtract $3x$ and add twelve: $x=10$.",
              "Check: $6(10-2)-2(10)=28$ and $3(10+1)-5=28$."
            ]
          }
        }
      }
    },
    {
      "key": "equations-special-cases/kp1",
      "source_path": "whole-course-teach/drafts/part-07.json",
      "original_document_sha256": "2e127c94e8fd01e30f3f2c31cf5adb8fbc0e05325cb6f1c2578336c73187321b",
      "changed": false,
      "document": {
        "kp_id": "equations-special-cases/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "Recognize a no-solution equation when the variable terms cancel and leave a false numeric statement.",
          "worked_example": {
            "problem": "Solve $4(x + 3) = 4x - 7$.",
            "steps": [
              "Distribute the left side: $4x + 12 = 4x - 7$.",
              "Subtract $4x$ from both sides: $12 = -7$.",
              "This statement is false for every value of $x$.",
              "Answer: no solution."
            ]
          }
        }
      }
    },
    {
      "key": "equations-special-cases/kp2",
      "source_path": "whole-course-teach/drafts/part-07.json",
      "original_document_sha256": "c52c19fe0e626c2084a9058f2086acd191bdbc52e278cb0add75adf75dc07891",
      "changed": false,
      "document": {
        "kp_id": "equations-special-cases/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Recognize an identity when both sides simplify to the exact same expression.",
          "worked_example": {
            "problem": "Solve $5(x - 2) = 5x - 10$.",
            "steps": [
              "Distribute the left side: $5x - 10 = 5x - 10$.",
              "Both sides are identical, so the equation is true for every value of $x$.",
              "Answer: all real numbers."
            ]
          }
        }
      }
    },
    {
      "key": "equations-special-cases/kp3",
      "source_path": "whole-course-teach/drafts/part-07.json",
      "original_document_sha256": "6d40a838504f344e4b3654ff6be1255710cd65901e58e928845ce798e382f559",
      "changed": true,
      "document": {
        "kp_id": "equations-special-cases/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "After simplifying a linear equation, compare its variable coefficients. Different coefficients leave one solution, which may be zero. Equal coefficients cancel: equal remaining constants make every real number a solution, while unequal constants give no solution.",
          "worked_example": {
            "problem": "Classify $2x+5=x+5$: one solution, no solution, or all real numbers.",
            "steps": [
              "Subtract $x$ from both sides: $x+5=5$.",
              "Subtract five: $x=0$.",
              "Zero is a value of the unknown. Substitution gives five on both sides.",
              "The equation has one solution."
            ]
          }
        }
      }
    },
    {
      "key": "equations-with-decimals/kp1",
      "source_path": "whole-course-teach/drafts/part-07.json",
      "original_document_sha256": "14c14faed1129b57d857444fa10990315e5f071edeba792046ea87226b067ebe",
      "changed": true,
      "document": {
        "kp_id": "equations-with-decimals/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "A decimal equation follows the same order as a whole-number equation: undo the addition or the subtraction first, then undo the multiplication. Keep the decimal values as they stand.",
          "worked_example": {
            "problem": "Solve $0.8x-1.4=5.8$.",
            "steps": [
              "Add $1.4$ to both sides: $0.8x=7.2$.",
              "Divide by $0.8$: $x=7.2/0.8=9$.",
              "Check: $0.8(9)-1.4=7.2-1.4=5.8$."
            ]
          }
        }
      }
    },
    {
      "key": "equations-with-decimals/kp2",
      "source_path": "whole-course-teach/drafts/part-07.json",
      "original_document_sha256": "19b5f6d0eb5317b699bd2df29072daac96d52455163c903699b7b4898a1c07b1",
      "changed": true,
      "document": {
        "kp_id": "equations-with-decimals/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Choose a power of ten that makes every decimal coefficient and constant an integer. Multiply every term on both sides by that same number. Then simplify and solve the resulting equation, and check in the original decimal equation.",
          "worked_example": {
            "problem": "Solve $0.25x+0.50=2.25$ by clearing decimals.",
            "steps": [
              "Two decimal places require multiplying every term by one hundred: $25x+50=225$.",
              "Subtract fifty from both sides: $25x=175$.",
              "Divide by twenty-five: $x=7$.",
              "Check: $0.25(7)+0.50=1.75+0.50=2.25$."
            ]
          }
        }
      }
    },
    {
      "key": "equations-with-fractions/kp1",
      "source_path": "whole-course-teach/drafts/part-07.json",
      "original_document_sha256": "3f16c95179d2654736018631ab0206dcff21adc4ec71414d66761f33191b5db2",
      "changed": true,
      "document": {
        "kp_id": "equations-with-fractions/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "Isolate the fractional term by undoing any outside addition or subtraction on both sides. Undo multiplication by a nonzero fraction with its reciprocal, or undo division by a nonzero number by multiplying. If a grouped numerator remains, solve that remaining equation and check.",
          "worked_example": {
            "problem": "Solve $\\frac{x}{5} - 2 = 3$.",
            "steps": [
              "Add $2$ to both sides: $\\frac{x}{5} = 5$.",
              "Multiply both sides by $5$: $x = 25$.",
              "Answer: $25$."
            ]
          }
        }
      }
    },
    {
      "key": "equations-with-fractions/kp2",
      "source_path": "whole-course-teach/drafts/part-07.json",
      "original_document_sha256": "e98962b7ec0329c64957a9bedb6f99c64c535a21ba25b424f6d0db3a6b473008",
      "changed": false,
      "document": {
        "kp_id": "equations-with-fractions/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Clear every denominator at once by multiplying the whole equation by the least common denominator.",
          "worked_example": {
            "problem": "Solve $\\frac{x}{4} + \\frac{x}{3} = 7$.",
            "steps": [
              "Find the least common denominator of $4$ and $3$: it is $12$.",
              "Multiply every term by $12$: $3x + 4x = 84$.",
              "Combine like terms: $7x = 84$.",
              "Divide both sides by $7$: $x = 12$.",
              "Answer: $12$."
            ]
          }
        }
      }
    },
    {
      "key": "equations-with-fractions/kp3",
      "source_path": "whole-course-teach/drafts/part-07.json",
      "original_document_sha256": "a883ac4b69447d5be0ec177ee7cca38d77846aa8ccd5952375ddaeabb4d4c9a3",
      "changed": true,
      "document": {
        "kp_id": "equations-with-fractions/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "Multiply every term on both sides by a common denominator to clear fractions, retaining any grouped numerators. Distribute to every term in those groups, combine like terms, and solve. Alternatively, distribute a fractional coefficient directly. Check the candidate in the original equation.",
          "worked_example": {
            "problem": "Solve $\\frac35(x-10)=12$ by distributing, and check.",
            "steps": [
              "Distribute the fraction to both terms: $3x/5-6=12$.",
              "Add six: $3x/5=18$.",
              "Multiply both sides by $5/3$: $x=30$.",
              "Check: $(3/5)(30-10)=(3/5)(20)=12$."
            ]
          }
        }
      }
    }
  ]
}
