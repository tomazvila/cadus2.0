{
  "status": "pending-independent-ai-review",
  "rows": [
    {
      "key": "polynomial-basics/kp1",
      "source_path": "whole-course-teach/drafts/part-19.json",
      "original_document_sha256": "20ecfa85864a70212739a6add00c1b8fed25004bcc96e9565099d7ed34b70258",
      "changed": true,
      "document": {
        "kp_id": "polynomial-basics/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "Combine like terms and remove zero terms first. The degree is the largest remaining exponent. The leading coefficient is the coefficient, including its sign, of that highest-degree term; it need not be the first term as originally written.",
          "worked_example": {
            "problem": "State the degree and leading coefficient of $6x^5-3x^4+x^2-9$.",
            "steps": [
              "The highest remaining power is $x^5$.",
              "The degree is $5$ and its coefficient is $6$."
            ]
          }
        }
      }
    },
    {
      "key": "polynomial-basics/kp2",
      "source_path": "whole-course-teach/drafts/part-19.json",
      "original_document_sha256": "eaede26fea6e6d8b814956e06ecada41508a0dcaca415fe3c25fc778979bd204",
      "changed": true,
      "document": {
        "kp_id": "polynomial-basics/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Combine like terms and remove zero terms before counting. One nonzero term is a monomial, two are a binomial, and three are a trinomial. Terms with different variable powers remain separate.",
          "worked_example": {
            "problem": "Combine like terms in $5x^3+7x-5x^3+2x-4$ and classify the result.",
            "steps": [
              "The cubic terms cancel, and $7x+2x=9x$.",
              "The result is $9x-4$, with two nonzero terms.",
              "It is a binomial."
            ]
          }
        }
      }
    },
    {
      "key": "polynomial-basics/kp3",
      "source_path": "whole-course-teach/drafts/part-19.json",
      "original_document_sha256": "f3e671a515d26c810a92e4cabea156ad159778b72dd227a36e4a67f9cbad48b8",
      "changed": true,
      "document": {
        "kp_id": "polynomial-basics/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "To write a polynomial in standard form, first combine like terms. Then arrange the nonzero terms in descending powers, keeping each coefficient and its sign attached to its variable power.",
          "worked_example": {
            "problem": "Write $4x-x^2+7+3x-5$ in standard form.",
            "steps": [
              "Combine $4x+3x=7x$ and $7-5=2$.",
              "Arrange powers from highest to lowest: $-x^2+7x+2$."
            ]
          }
        }
      }
    },
    {
      "key": "evaluating-polynomials/kp1",
      "source_path": "whole-course-teach/drafts/part-08.json",
      "original_document_sha256": "b36ca729f58c3b480291ddfc56edf60c8e3834ac37264f733d2adc4481f4a637",
      "changed": true,
      "document": {
        "kp_id": "evaluating-polynomials/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "Substitute the positive input for every occurrence of the variable. Evaluate powers first, then multiplication, then addition and subtraction. For a nested expression, work from the innermost parentheses outward.",
          "worked_example": {
            "problem": "Evaluate $q(x)=x^3-2x$ at $x=3$.",
            "steps": [
              "Substitute: $q(3)=3^3-2\\cdot3$.",
              "Compute $27-6=21$."
            ]
          }
        }
      }
    },
    {
      "key": "evaluating-polynomials/kp2",
      "source_path": "whole-course-teach/drafts/part-08.json",
      "original_document_sha256": "f9635374b831ff64361b1d1afa48bf155dfb53f6b3b239df91e56e07ca050e88",
      "changed": true,
      "document": {
        "kp_id": "evaluating-polynomials/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Put parentheses around a negative input whenever substituting. Apply the power to the entire parenthesized input. Apply a minus sign outside the power afterward. Thus $(-a)^2$ and $-a^2$ have different signs for nonzero $a$.",
          "worked_example": {
            "problem": "Evaluate $r(x)=-x^2+3$ at $x=-5$.",
            "steps": [
              "Substitute: $r(-5)=-(-5)^2+3$.",
              "Square the input first: $(-5)^2=25$.",
              "Apply the leading minus and add: $-25+3=-22$."
            ]
          }
        }
      }
    },
    {
      "key": "evaluating-polynomials/kp3",
      "source_path": "whole-course-teach/drafts/part-09.json",
      "original_document_sha256": "f89d9707abd02442c044781bd0d45300bfe5d4fe76401b0e44c2491ed56b8701",
      "changed": true,
      "document": {
        "kp_id": "evaluating-polynomials/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "Identify the requested formula value and substitute the given input for its variable. Evaluate powers before products and sums. Report the output with the units supplied by the context.",
          "worked_example": {
            "problem": "A ball height in metres is $h=-5t^2+25t$. Find $h$ at $t=2$.",
            "steps": [
              "Substitute once: $h=-5(2)^2+25(2)$.",
              "Compute $-20+50=30$.",
              "The height is $30$ metres."
            ]
          }
        }
      }
    },
    {
      "key": "adding-polynomials/kp1",
      "source_path": "whole-course-teach/drafts/part-01.json",
      "original_document_sha256": "4979fccf14aee0a0ed2ed835abdbacf8525a208fa0e0a1bb2a9ad609e94c5c6a",
      "changed": false,
      "document": {
        "kp_id": "adding-polynomials/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "To add two linear polynomials, combine the x-terms with each other and the constant terms with each other, then write the result in standard form.",
          "worked_example": {
            "problem": "Add $(-6x + 14) + (9x - 2)$.",
            "steps": [
              "Combine the x-terms: $-6x + 9x = 3x$.",
              "Combine the constants: $14 - 2 = 12$.",
              "The sum in standard form is $3x + 12$."
            ]
          }
        }
      }
    },
    {
      "key": "adding-polynomials/kp2",
      "source_path": "whole-course-teach/drafts/part-01.json",
      "original_document_sha256": "1a8b04c74f69d2e5125521cdb86fc419423fcbd244e772ede993dfbf36f4b573",
      "changed": false,
      "document": {
        "kp_id": "adding-polynomials/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "To add two quadratics, combine terms of the same degree separately: the x^2 terms, the x terms, and the constants.",
          "worked_example": {
            "problem": "Add $(-4x^2 + 7x - 9) + (10x^2 - 7x + 3)$.",
            "steps": [
              "Combine the $x^2$ terms: $-4x^2 + 10x^2 = 6x^2$.",
              "Combine the $x$ terms: $7x - 7x = 0$.",
              "Combine the constants: $-9 + 3 = -6$.",
              "The sum in standard form is $6x^2 - 6$."
            ]
          }
        }
      }
    },
    {
      "key": "adding-polynomials/kp3",
      "source_path": "whole-course-teach/drafts/part-01.json",
      "original_document_sha256": "c9f0d99f97345a4b86a58cbaaf882dd4819d57b474ca04358940e4cfeea2dd6c",
      "changed": false,
      "document": {
        "kp_id": "adding-polynomials/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "When adding polynomials with missing powers, treat each missing power as having a coefficient of 0 before combining like terms, and keep the result in standard form.",
          "worked_example": {
            "problem": "Add $(5x^4 - 3x + 8) + (-2x^4 + 6x^2 - 8)$.",
            "steps": [
              "Line up by power, filling gaps with 0: first polynomial has $0x^2$; second has $0x$.",
              "Combine $x^4$ terms: $5x^4 - 2x^4 = 3x^4$.",
              "Combine $x^2$ terms: $0x^2 + 6x^2 = 6x^2$.",
              "Combine $x$ terms: $-3x + 0x = -3x$.",
              "Combine constants: $8 - 8 = 0$.",
              "The sum in standard form is $3x^4 + 6x^2 - 3x$."
            ]
          }
        }
      }
    },
    {
      "key": "polynomial-addition-subtraction/kp1",
      "source_path": "whole-course-teach/drafts/part-19.json",
      "original_document_sha256": "2009a91ba72b20e4fc9ab5bf00b10b003af04a04bfe000988314a8d0f9de267e",
      "changed": true,
      "document": {
        "kp_id": "polynomial-addition-subtraction/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "To subtract a polynomial, distribute the subtraction sign to every term of that polynomial. Then combine coefficients of matching powers and write the result in descending powers.",
          "worked_example": {
            "problem": "Subtract $4x^2-7x+2$ from $9x^2+3x-10$.",
            "steps": [
              "Set up $(9x^2+3x-10)-(4x^2-7x+2)$.",
              "Distribute: $9x^2+3x-10-4x^2+7x-2$.",
              "Combine like terms to obtain $5x^2+10x-12$."
            ]
          }
        }
      }
    },
    {
      "key": "polynomial-addition-subtraction/kp2",
      "source_path": "whole-course-teach/drafts/part-19.json",
      "original_document_sha256": "e5a0ba5989da288be337bf55ced63f9c1d8d887835713ead299df2f48320f862",
      "changed": true,
      "document": {
        "kp_id": "polynomial-addition-subtraction/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Align matching powers, using coefficient zero for any missing power. Subtract every coefficient of the second polynomial, preserving signs. Remove terms whose coefficients cancel and write the rest in descending powers.",
          "worked_example": {
            "problem": "Simplify $(2x^3-5x+6)-(2x^3+x^2-5x-3)$.",
            "steps": [
              "Distribute the subtraction: $2x^3-5x+6-2x^3-x^2+5x+3$.",
              "The cubic and linear terms cancel.",
              "The remaining terms give $-x^2+9$."
            ]
          }
        }
      }
    },
    {
      "key": "polynomial-addition-subtraction/kp3",
      "source_path": "whole-course-teach/drafts/part-19.json",
      "original_document_sha256": "611ddc5616b9e860e48e1753f392b3a779143474869df9dcaa77da0131de8ee9",
      "changed": true,
      "document": {
        "kp_id": "polynomial-addition-subtraction/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "Remove parentheses by distributing each preceding sign across its whole polynomial. Collect coefficients of each power across all three polynomials, including any implicit zero coefficients, then write standard form.",
          "worked_example": {
            "problem": "Simplify $(5x^2-3x+4)+(2x^2+6)-(3x^2-x+9)$.",
            "steps": [
              "The third polynomial contributes $-3x^2+x-9$.",
              "The quadratic coefficient is $5+2-3=4$.",
              "The linear coefficient is $-3+0+1=-2$, and the constant is $4+6-9=1$.",
              "The result is $4x^2-2x+1$."
            ]
          }
        }
      }
    },
    {
      "key": "multiplying-monomials-polynomials/kp1",
      "source_path": "whole-course-teach/drafts/part-16.json",
      "original_document_sha256": "87b6db2b288d32d3748e5e07abd48e3e5d240bbb8441b7e1c7324a546828d8d7",
      "changed": true,
      "document": {
        "kp_id": "multiplying-monomials-polynomials/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "Multiply the signed coefficients of the monomials and add exponents on their common variable base. A bare variable has exponent one.",
          "worked_example": {
            "problem": "Multiply $(-7x^4)(6x^5)$.",
            "steps": [
              "The coefficient is $(-7)\\cdot6=-42$.",
              "The variable exponent is $4+5=9$.",
              "The product is $-42x^9$."
            ]
          }
        }
      }
    },
    {
      "key": "multiplying-monomials-polynomials/kp2",
      "source_path": "whole-course-teach/drafts/part-16.json",
      "original_document_sha256": "030a043e4199f3476889b3f716ccc2983d967b9c078e91f8a2bda81e6164ba2e",
      "changed": true,
      "document": {
        "kp_id": "multiplying-monomials-polynomials/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Distribute the positive monomial to every term of the binomial or trinomial. In each product, multiply coefficients and add exponents on the shared base. Combine any like terms and write the expanded polynomial.",
          "worked_example": {
            "problem": "Expand $5x(3x^2-x+8)$.",
            "steps": [
              "The three products are $15x^3$, $-5x^2$ and $40x$.",
              "The powers differ, so the expanded result is $15x^3-5x^2+40x$."
            ]
          }
        }
      }
    },
    {
      "key": "multiplying-monomials-polynomials/kp3",
      "source_path": "whole-course-teach/drafts/part-16.json",
      "original_document_sha256": "2599d6aa28f865bc25139a999dd0c8ba4a2399d11be9dc33c5abd2ffbddfdb00",
      "changed": true,
      "document": {
        "kp_id": "multiplying-monomials-polynomials/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "Distribute the entire negative monomial to every term. Multiply the signs as well as the coefficient magnitudes: a negative times a positive is negative, and a negative times a negative is positive. Add shared-base exponents in each product.",
          "worked_example": {
            "problem": "Expand $-6x^2(2x^2-5x+1)$.",
            "steps": [
              "The first product is $(-6x^2)(2x^2)=-12x^4$.",
              "The second is $(-6x^2)(-5x)=30x^3$.",
              "The third is $(-6x^2)(1)=-6x^2$.",
              "The result is $-12x^4+30x^3-6x^2$."
            ]
          }
        }
      }
    },
    {
      "key": "multiplying-binomials/kp1",
      "source_path": "whole-course-teach/drafts/part-16.json",
      "original_document_sha256": "b33d9e2e5db2a694dbd6af3bd5522e64f36db93f0769176742ac7a4a6cbe84a5",
      "changed": true,
      "document": {
        "kp_id": "multiplying-binomials/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "Multiply each term of the first binomial by each term of the second, giving four signed products. Combine the two linear products: $(x+a)(x+b)=x^2+(a+b)x+ab$.",
          "worked_example": {
            "problem": "Expand $(x+7)(x-9)$.",
            "steps": [
              "The four products are $x^2$, $-9x$, $7x$ and $-63$.",
              "Combine $-9x+7x=-2x$.",
              "The result is $x^2-2x-63$."
            ]
          }
        }
      }
    },
    {
      "key": "multiplying-binomials/kp2",
      "source_path": "whole-course-teach/drafts/part-16.json",
      "original_document_sha256": "cccb837df88deb6f63c56922838f1fe17bc7cdb77e036cd29b338f1831bf4d13",
      "changed": true,
      "document": {
        "kp_id": "multiplying-binomials/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "When one binomial has a leading coefficient greater than one, include that coefficient in both of its term products. Form all four products, preserve their signs, and combine like terms.",
          "worked_example": {
            "problem": "Expand $(5x-3)(x+2)$.",
            "steps": [
              "The products are $5x^2$, $10x$, $-3x$ and $-6$.",
              "The linear terms combine to $7x$.",
              "The result is $5x^2+7x-6$."
            ]
          }
        }
      }
    },
    {
      "key": "multiplying-binomials/kp3",
      "source_path": "whole-course-teach/drafts/part-16.json",
      "original_document_sha256": "d27f0887e5cd31a6e970d532db45e312eafa601801f04c0693770ffe09c3e912",
      "changed": true,
      "document": {
        "kp_id": "multiplying-binomials/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "For $(ax+b)(cx+d)$, form the four signed products $acx^2$, $adx$, $bcx$ and $bd$. This works for positive or negative constants in either factor. Combine the middle terms to obtain $acx^2+(ad+bc)x+bd$.",
          "worked_example": {
            "problem": "Expand $(4x+5)(3x-2)$.",
            "steps": [
              "The products are $12x^2$, $-8x$, $15x$ and $-10$.",
              "Combine $-8x+15x=7x$.",
              "The result is $12x^2+7x-10$."
            ]
          }
        }
      }
    },
    {
      "key": "polynomial-multiplication/kp1",
      "source_path": "whole-course-teach/drafts/part-19.json",
      "original_document_sha256": "4cb144b0319039ea1c4883b0d61bba8cb5fefecc48f616645b955a67a105acc7",
      "changed": true,
      "document": {
        "kp_id": "polynomial-multiplication/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "Multiply each of the two binomial terms by all three trinomial terms, producing six products. Combine matching powers and write the expanded result in descending powers.",
          "worked_example": {
            "problem": "Expand $(x-5)(x^2+3x-2)$.",
            "steps": [
              "Multiplying by $x$ gives $x^3+3x^2-2x$.",
              "Multiplying by $-5$ gives $-5x^2-15x+10$.",
              "Combine the six products: $x^3-2x^2-17x+10$."
            ]
          }
        }
      }
    },
    {
      "key": "polynomial-multiplication/kp2",
      "source_path": "whole-course-teach/drafts/part-20.json",
      "original_document_sha256": "e1e1ca76f161a62c7c35154a85f8bd891adf7f28f9f85372e3db352f75a1a396",
      "changed": true,
      "document": {
        "kp_id": "polynomial-multiplication/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Multiply two factors first and simplify their product. Then multiply that complete result by the third factor, distributing to every term and combining like powers.",
          "worked_example": {
            "problem": "Expand $(x-4)(x+2)(x+6)$.",
            "steps": [
              "The first two factors give $x^2-2x-8$.",
              "Multiplying by $x+6$ gives $x^3+6x^2-2x^2-12x-8x-48$.",
              "Combine to obtain $x^3+4x^2-20x-48$."
            ]
          }
        }
      }
    },
    {
      "key": "polynomial-multiplication/kp3",
      "source_path": "whole-course-teach/drafts/part-20.json",
      "original_document_sha256": "92df01c0cb806ba2105fd313796bb90933b3c49dc0b26b14edfe7a01ecd2d7bc",
      "changed": true,
      "document": {
        "kp_id": "polynomial-multiplication/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "A product of two trinomials has nine term products. Multiply each term in the first trinomial by every term in the second. Group by power and remove any complete cancellations.",
          "worked_example": {
            "problem": "Expand $(x^2+2x-3)(x^2-2x+5)$.",
            "steps": [
              "The $x^2$ row is $x^4-2x^3+5x^2$.",
              "The $2x$ row is $2x^3-4x^2+10x$.",
              "The $-3$ row is $-3x^2+6x-15$.",
              "The cubic terms cancel, and the quadratic coefficient is $5-4-3=-2$.",
              "The result is $x^4-2x^2+16x-15$."
            ]
          }
        }
      }
    },
    {
      "key": "special-products/kp1",
      "source_path": "whole-course-teach/drafts/part-26.json",
      "original_document_sha256": "81b42731bb52115efbd2f68ecbd829ace2f922798799a2c97147660cfaddbeef",
      "changed": true,
      "document": {
        "kp_id": "special-products/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "A squared binomial includes both cross-products: $(a+b)^2=a^2+2ab+b^2$ and $(a-b)^2=a^2-2ab+b^2$. The middle term is twice the product, and the final squared term is positive in both patterns.",
          "worked_example": {
            "problem": "Expand $(x-5)^2$.",
            "steps": [
              "Use $a=x$ and $b=5$ in the difference-square pattern.",
              "The three terms are $x^2$, $-2(x)(5)=-10x$ and $5^2=25$.",
              "The result is $x^2-10x+25$."
            ]
          }
        }
      }
    },
    {
      "key": "special-products/kp2",
      "source_path": "whole-course-teach/drafts/part-26.json",
      "original_document_sha256": "d3b5585770e6d7359a6800ce44a33a475cf3392156aaaeba4a483c740eff926f",
      "changed": true,
      "document": {
        "kp_id": "special-products/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Conjugate binomials share their two terms but have opposite connecting signs. Their cross-products cancel, giving $(a+b)(a-b)=a^2-b^2$. Square each complete term, including any coefficient.",
          "worked_example": {
            "problem": "Expand $(5x+9)(5x-9)$.",
            "steps": [
              "Use $a=5x$ and $b=9$.",
              "The product is $(5x)^2-9^2=25x^2-81$."
            ]
          }
        }
      }
    },
    {
      "key": "special-products/kp3",
      "source_path": "whole-course-teach/drafts/part-26.json",
      "original_document_sha256": "76a09a7fed9a42a53ca9666e407411d13dd1136b140a742880631db97bf28d6d",
      "changed": true,
      "document": {
        "kp_id": "special-products/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "For a squared binomial with a coefficient on the variable, identify the whole first term as $a$. Compute $a^2$, the signed middle term $2ab$, and $b^2$. A sum gives a positive middle term and a difference gives a negative one.",
          "worked_example": {
            "problem": "Expand $(7x-3)^2$.",
            "steps": [
              "Use $a=7x$ and $b=3$.",
              "The first term is $(7x)^2=49x^2$.",
              "The middle term is $-2(7x)(3)=-42x$, and the last is $3^2=9$.",
              "The result is $49x^2-42x+9$."
            ]
          }
        }
      }
    }
  ],
  "supersedes_sha256": "502ba9a19b8230c38a17c549fc416a034a67f0432ec4161e4c52d9e3ab1ad5ce",
  "revision_reason": "Fix even-power wording and use independent worked operands for formula substitution."
}
