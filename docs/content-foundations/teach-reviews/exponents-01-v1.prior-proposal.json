{
  "status": "pending-independent-ai-review",
  "rows": [
    {
      "key": "exponent-product-rule/kp1",
      "source_path": "whole-course-teach/drafts/part-09.json",
      "original_document_sha256": "85a686be8b18140fb2260f7872b56df98c55883dcf957ffb2755ec834178ac60",
      "changed": true,
      "document": {
        "kp_id": "exponent-product-rule/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "For powers with the same base, keep that base and add the exponents: $a^m a^n=a^{m+n}$. Each exponent counts factors of the shared base.",
          "worked_example": {
            "problem": "Simplify $x^4\\cdot x^2$.",
            "steps": [
              "The two powers have the same base $x$.",
              "Add their exponents: $4+2=6$.",
              "Therefore $x^4\\cdot x^2=x^6$."
            ]
          }
        }
      }
    },
    {
      "key": "exponent-product-rule/kp2",
      "source_path": "whole-course-teach/drafts/part-09.json",
      "original_document_sha256": "528efa149b24aa180fc6bf0388f8224dbce54beeb466be328f3d9cb109245413",
      "changed": true,
      "document": {
        "kp_id": "exponent-product-rule/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "To write a product of powers of the same numeric base as one power, add the exponents and retain the original base. Leave the power unevaluated when exponent form is requested.",
          "worked_example": {
            "problem": "Write $6^2\\cdot6^4$ as a single power of $6$.",
            "steps": [
              "Both factors have base $6$, so add $2+4=6$.",
              "The requested single power is $6^6$."
            ]
          }
        }
      }
    },
    {
      "key": "exponent-product-rule/kp3",
      "source_path": "whole-course-teach/drafts/part-09.json",
      "original_document_sha256": "492c12a57415866f10cf703899fc4425f3e02efc250d8f2eadfaf1e17e54af42",
      "changed": true,
      "document": {
        "kp_id": "exponent-product-rule/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "A bare base has exponent one. When multiplying three or more powers of the same base, include every factor and add all their exponents.",
          "worked_example": {
            "problem": "Simplify $x^2\\cdot x\\cdot x^4$.",
            "steps": [
              "Write the bare factor as $x=x^1$.",
              "Add all three exponents: $2+1+4=7$.",
              "The result is $x^7$."
            ]
          }
        }
      }
    },
    {
      "key": "exponent-quotient-rule/kp1",
      "source_path": "whole-course-teach/drafts/part-09.json",
      "original_document_sha256": "89da7bc3a1089e2751be320025f52b83208d10a3a7957d009271b8125c89521e",
      "changed": true,
      "document": {
        "kp_id": "exponent-quotient-rule/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "For a quotient of powers of the same nonzero base, subtract the denominator exponent from the numerator exponent: $a^m/a^n=a^{m-n}$. A larger exponent on top leaves a positive exponent.",
          "worked_example": {
            "problem": "Simplify $x^9/x^4$ for $x\\ne0$.",
            "steps": [
              "The bases match and the denominator is nonzero.",
              "Subtract the exponents in order: $9-4=5$.",
              "The result is $x^5$."
            ]
          }
        }
      }
    },
    {
      "key": "exponent-quotient-rule/kp2",
      "source_path": "whole-course-teach/drafts/part-09.json",
      "original_document_sha256": "22f9c58349205db3b847d9aec418b8f8c391ce26cdf4080b194046ec189f5259",
      "changed": true,
      "document": {
        "kp_id": "exponent-quotient-rule/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "To write a quotient of powers as one power of the original nonzero numeric base, subtract the bottom exponent from the top exponent. Keep the result in exponent form, including an explicit exponent one when requested.",
          "worked_example": {
            "problem": "Write $11^8/11^3$ as a single power of $11$.",
            "steps": [
              "Subtract the exponents: $8-3=5$.",
              "The requested single power is $11^5$."
            ]
          }
        }
      }
    },
    {
      "key": "exponent-quotient-rule/kp3",
      "source_path": "whole-course-teach/drafts/part-09.json",
      "original_document_sha256": "052e0dbd80c749190cfdcf507988cacffabda3da9ebf0fbd93b0dc07b038f225",
      "changed": true,
      "document": {
        "kp_id": "exponent-quotient-rule/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "In a quotient of powers of a nonzero base, a bare base has exponent one. Subtract exponents in numerator-minus-denominator order. A resulting first power simplifies to the bare base; for example, $a^1=a$.",
          "worked_example": {
            "problem": "Simplify $w^{11}/w^{10}$ for $w\\ne0$.",
            "steps": [
              "Subtract the exponents: $11-10=1$.",
              "Thus $w^{11}/w^{10}=w^1=w$."
            ]
          }
        }
      }
    },
    {
      "key": "exponent-product-quotient-rules/kp1",
      "source_path": "whole-course-teach/drafts/part-09.json",
      "original_document_sha256": "ea76a306dbab7923fee54d42f24ffb495bf4c13f3f436a75ff7bd191352e4261",
      "changed": true,
      "document": {
        "kp_id": "exponent-product-quotient-rules/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "Combine a product in the numerator by adding exponents on its common base, then divide by subtracting the denominator exponent. The base must be nonzero when it occurs in a denominator.",
          "worked_example": {
            "problem": "Simplify $(x^6\\cdot x^2)/x^5$ for $x\\ne0$.",
            "steps": [
              "The numerator is $x^{6+2}=x^8$.",
              "Divide: $x^8/x^5=x^{8-5}=x^3$."
            ]
          }
        }
      }
    },
    {
      "key": "exponent-product-quotient-rules/kp2",
      "source_path": "whole-course-teach/drafts/part-09.json",
      "original_document_sha256": "feff632a2d7000d9903b48e75dfad41e7b8fda44419dea6f9716339757279be8",
      "changed": true,
      "document": {
        "kp_id": "exponent-product-quotient-rules/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Multiply or divide the numeric coefficients separately. For each shared variable base, add exponents in a product and subtract them in a quotient. Variables in denominators must be nonzero.",
          "worked_example": {
            "problem": "Simplify $(5x^3)(8x^4)/(4x^2)$ for $x\\ne0$.",
            "steps": [
              "The coefficient is $(5\\cdot8)/4=10$.",
              "The exponent is $3+4-2=5$.",
              "The result is $10x^5$."
            ]
          }
        }
      }
    },
    {
      "key": "exponent-product-quotient-rules/kp3",
      "source_path": "whole-course-teach/drafts/part-09.json",
      "original_document_sha256": "da04a96feb182f7f614520ae3f4a306ab62c4299f1b5631c1932d5ff30421a7f",
      "changed": true,
      "document": {
        "kp_id": "exponent-product-quotient-rules/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "Handle each variable base separately: add exponents when multiplying and subtract them when dividing. A bare variable has exponent one. Preserve any nonzero restrictions from the original denominator.",
          "worked_example": {
            "problem": "Simplify $(x^5y^3)(x^2y^2)/(x^3y)$ for $x,y\\ne0$.",
            "steps": [
              "For $x$, the exponent is $5+2-3=4$.",
              "For $y$, the exponent is $3+2-1=4$.",
              "The result is $x^4y^4$."
            ]
          }
        }
      }
    },
    {
      "key": "power-of-a-power-rule/kp1",
      "source_path": "whole-course-teach/drafts/part-20.json",
      "original_document_sha256": "d014285215fd5e3a2e28cb4f1e18cf382f525c0857806780db51bca2c2793155",
      "changed": true,
      "document": {
        "kp_id": "power-of-a-power-rule/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "When a power is raised to another positive integer power, multiply the exponents: $(a^m)^n=a^{mn}$. The outer exponent counts copies of the inner power.",
          "worked_example": {
            "problem": "Simplify $(x^4)^3$.",
            "steps": [
              "Multiply the inner and outer exponents: $4\\cdot3=12$.",
              "Therefore $(x^4)^3=x^{12}$."
            ]
          }
        }
      }
    },
    {
      "key": "power-of-a-power-rule/kp2",
      "source_path": "whole-course-teach/drafts/part-20.json",
      "original_document_sha256": "c9ccbfc318abb74f963a9d37312c40af3cc37d45ce7b5ddb3e94e488bc050b58",
      "changed": true,
      "document": {
        "kp_id": "power-of-a-power-rule/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "For a numeric power raised to a power, retain the original base and multiply the exponents. Leave the result as one unevaluated power when exponent form is requested.",
          "worked_example": {
            "problem": "Write $(7^4)^5$ as a single power of $7$.",
            "steps": [
              "Multiply the exponents: $4\\cdot5=20$.",
              "The requested result is $7^{20}$."
            ]
          }
        }
      }
    },
    {
      "key": "power-of-a-power-rule/kp3",
      "source_path": "whole-course-teach/drafts/part-20.json",
      "original_document_sha256": "2139457d8560bc56309f9d117fe5fe3545202cb0c63ad6ac9a4ba9faa9c82701",
      "changed": true,
      "document": {
        "kp_id": "power-of-a-power-rule/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "First simplify each power of a power by multiplying its exponents. Then combine matching bases: add exponents for multiplication or subtract for division. A divisor must be nonzero.",
          "worked_example": {
            "problem": "Simplify $(a^3)^2\\cdot a^5$.",
            "steps": [
              "The nested power becomes $a^{3\\cdot2}=a^6$.",
              "Multiply the powers: $a^6\\cdot a^5=a^{6+5}=a^{11}$."
            ]
          }
        }
      }
    },
    {
      "key": "power-rule-exponents/kp1",
      "source_path": "whole-course-teach/drafts/part-20.json",
      "original_document_sha256": "fe649861af277d18a0533114cafcfe6cf0c9572b246081463c71a4914cf45f9d",
      "changed": true,
      "document": {
        "kp_id": "power-rule-exponents/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "A power of a product applies to every factor: $(ab)^n=a^nb^n$. Raise the coefficient to the power and multiply any nested variable exponents.",
          "worked_example": {
            "problem": "Simplify $(7x^5)^2$.",
            "steps": [
              "Raise both factors: $7^2(x^5)^2$.",
              "Compute $7^2=49$ and $5\\cdot2=10$.",
              "The result is $49x^{10}$."
            ]
          }
        }
      }
    },
    {
      "key": "power-rule-exponents/kp2",
      "source_path": "whole-course-teach/drafts/part-20.json",
      "original_document_sha256": "93cf23037d9e5815efd3d7b8577fd361dc51bdbf5bd51545dd8aeec4a34e3ffe",
      "changed": true,
      "document": {
        "kp_id": "power-rule-exponents/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "A power of a quotient applies to the whole numerator and the whole denominator: $(a/b)^n=a^n/b^n$, with $b\\ne0$. Multiply nested exponents and evaluate numeric powers.",
          "worked_example": {
            "problem": "Simplify $(x^5/y^2)^3$ for $y\\ne0$.",
            "steps": [
              "Raise numerator and denominator: $(x^5)^3/(y^2)^3$.",
              "The numerator is $x^{15}$ and the denominator is $y^6$.",
              "The result is $x^{15}/y^6$."
            ]
          }
        }
      }
    },
    {
      "key": "power-rule-exponents/kp3",
      "source_path": "whole-course-teach/drafts/part-20.json",
      "original_document_sha256": "972263096a9f0c4db1b2ee5fdb00ed1cc41705eaffb22e3876ff1dae25d47266",
      "changed": true,
      "document": {
        "kp_id": "power-rule-exponents/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "Apply powers to every factor inside parentheses first, including numeric coefficients. Then multiply the resulting coefficients and add exponents on each common base.",
          "worked_example": {
            "problem": "Simplify $(3x^2)^2(2x)$.",
            "steps": [
              "The powered product is $3^2x^{2\\cdot2}=9x^4$.",
              "Multiply coefficients: $9\\cdot2=18$.",
              "Add exponents: $4+1=5$, giving $18x^5$."
            ]
          }
        }
      }
    },
    {
      "key": "zero-exponent-rule/kp1",
      "source_path": "curated-completion/teach-04.json",
      "original_document_sha256": "ad482ca71b5a5f6ad8e9bfc6c814128c6742f1c7e1814d0527f8a5ea715a4f12",
      "changed": false,
      "document": {
        "kp_id": "zero-exponent-rule/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "Every nonzero base raised to the zero power equals one, including a nonzero fraction.",
          "worked_example": {
            "problem": "Simplify $\\left(\\frac12\\right)^0$.",
            "steps": [
              "The base is $\\frac12$, which is nonzero.",
              "Apply the zero-exponent rule: $\\left(\\frac12\\right)^0=1$.",
              "Thus the expression simplifies to $1$."
            ]
          }
        }
      }
    },
    {
      "key": "zero-exponent-rule/kp2",
      "source_path": "whole-course-teach/drafts/part-30.json",
      "original_document_sha256": "62a8c2ce7406eae3645ba3d8389baae9ccf71e6fb6b0f6ab90b78e0f10ef394c",
      "changed": true,
      "document": {
        "kp_id": "zero-exponent-rule/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Identify the complete base carrying exponent zero. For nonzero $a$ and $x$, $(ax)^0=1$, while $ax^0=a\\cdot1=a$. Parentheses determine whether the coefficient is part of the base.",
          "worked_example": {
            "problem": "For $x\\ne0$, simplify $(4x)^0$ and $4x^0$.",
            "steps": [
              "In $(4x)^0$, the entire nonzero product is the base, so the value is $1$.",
              "In $4x^0$, only $x$ has exponent zero, so the value is $4\\cdot1=4$.",
              "The results, in the requested order, are $1$ and $4$."
            ]
          }
        }
      }
    },
    {
      "key": "zero-exponent-rule/kp3",
      "source_path": "curated-completion/teach-04.json",
      "original_document_sha256": "4540e21462ef87ae33dabeeddcf53ebf85a5ff2263ad6709d11bcece93b72a32",
      "changed": false,
      "document": {
        "kp_id": "zero-exponent-rule/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "The quotient rule explains the zero exponent: dividing equal nonzero powers gives both exponent difference zero and numerical value one.",
          "worked_example": {
            "problem": "Use the quotient rule to simplify $\\frac{7^4}{7^4}$.",
            "steps": [
              "Subtract exponents for the common base: $\\frac{7^4}{7^4}=7^{4-4}=7^0$.",
              "The original fraction is also $1$ because a nonzero number divided by itself is $1$.",
              "Therefore $7^0=1$."
            ]
          }
        }
      }
    },
    {
      "key": "negative-zero-exponents/kp1",
      "source_path": "whole-course-teach/drafts/part-17.json",
      "original_document_sha256": "ec1f58d0dedb74c01030f0951e5e58faad403c0380430ecd40a21a3c9fd2a5df",
      "changed": true,
      "document": {
        "kp_id": "negative-zero-exponents/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "For a nonzero base, a negative exponent gives the reciprocal of the corresponding positive power: $a^{-n}=1/a^n$. Evaluate numeric powers when an exact fraction is requested; retain symbolic positive powers for variables.",
          "worked_example": {
            "problem": "Write $3^{-3}$ as a fraction.",
            "steps": [
              "Use the reciprocal rule: $3^{-3}=1/3^3$.",
              "Compute $3^3=27$.",
              "The exact fraction is $1/27$."
            ]
          }
        }
      }
    },
    {
      "key": "negative-zero-exponents/kp2",
      "source_path": "whole-course-teach/drafts/part-17.json",
      "original_document_sha256": "78fdd55a68683f45329023c089d2dc5b4360c9a82ba6f3dd88746d11d82d7892",
      "changed": true,
      "document": {
        "kp_id": "negative-zero-exponents/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "For a nonzero base, dividing by $a^{-n}=1/a^n$ is multiplying by $a^n$, so $1/a^{-n}=a^n$. A nonzero fraction raised to exponent $-1$ is its reciprocal: $(a/b)^{-1}=b/a$, where $a,b\\ne0$.",
          "worked_example": {
            "problem": "Rewrite $1/y^{-5}$ with a positive exponent, for $y\\ne0$.",
            "steps": [
              "The denominator is $y^{-5}=1/y^5$.",
              "Divide by the fraction by multiplying by its reciprocal: $1/(1/y^5)=y^5$."
            ]
          }
        }
      }
    },
    {
      "key": "negative-zero-exponents/kp3",
      "source_path": "whole-course-teach/drafts/part-17.json",
      "original_document_sha256": "6a3a3fbc711bf2b592d08bf08356a6048eb7453478545afe9b6c507a194702e0",
      "changed": true,
      "document": {
        "kp_id": "negative-zero-exponents/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "Combine exponents on each shared nonzero base first, using addition for multiplication and subtraction for division. Rewrite any resulting negative exponent as a reciprocal. Keep coefficients outside that reciprocal unless they also carry a negative power.",
          "worked_example": {
            "problem": "Simplify $3x^2\\cdot x^{-5}$ with positive exponents, for $x\\ne0$.",
            "steps": [
              "Add the exponents: $2+(-5)=-3$.",
              "The expression becomes $3x^{-3}$.",
              "Since $x^{-3}=1/x^3$, the result is $3/x^3$."
            ]
          }
        }
      }
    },
    {
      "key": "simplifying-negative-exponent-expressions/kp1",
      "source_path": "whole-course-teach/drafts/part-24.json",
      "original_document_sha256": "6215f2a23bfacac6d5cd98b8ca1b9742d5d209884d5b3296406b45113996003d",
      "changed": true,
      "document": {
        "kp_id": "simplifying-negative-exponent-expressions/kp1",
        "kind": "teach",
        "arguments": {
          "concept": "Divide powers of a nonzero base by subtracting the whole denominator exponent, including its sign. Simplify the exponent arithmetic, then rewrite any negative result as a reciprocal so the final exponents are positive.",
          "worked_example": {
            "problem": "Simplify $y^{-4}/y^{-1}$ with a positive exponent, for $y\\ne0$.",
            "steps": [
              "Subtract the signed exponent: $-4-(-1)=-4+1=-3$.",
              "The quotient is $y^{-3}=1/y^3$."
            ]
          }
        }
      }
    },
    {
      "key": "simplifying-negative-exponent-expressions/kp2",
      "source_path": "whole-course-teach/drafts/part-24.json",
      "original_document_sha256": "f1fc60a236137b3def2430e5504954531e8548e6c6e3d583b9d44bb6764baeec",
      "changed": true,
      "document": {
        "kp_id": "simplifying-negative-exponent-expressions/kp2",
        "kind": "teach",
        "arguments": {
          "concept": "Raise each factor of a product to the outer power. Multiply inner and outer variable exponents, keeping their signs. Rewrite negative powers as reciprocals; the affected bases must be nonzero.",
          "worked_example": {
            "problem": "Simplify $(3x^{-4})^2$ with positive exponents, for $x\\ne0$.",
            "steps": [
              "Raise the coefficient: $3^2=9$.",
              "Multiply the variable exponents: $(-4)\\cdot2=-8$.",
              "Therefore $9x^{-8}=9/x^8$."
            ]
          }
        }
      }
    },
    {
      "key": "simplifying-negative-exponent-expressions/kp3",
      "source_path": "whole-course-teach/drafts/part-24.json",
      "original_document_sha256": "cc36615fbb74367c906d02d665d6f6abff5c81718ad5a9d80e9ad4acaf534b20",
      "changed": true,
      "document": {
        "kp_id": "simplifying-negative-exponent-expressions/kp3",
        "kind": "teach",
        "arguments": {
          "concept": "Reduce numeric coefficients and handle each variable base separately. Combine signed exponents, then place factors with negative exponents on the opposite side of the fraction bar with positive exponents. A negative exponent on a whole product applies to every factor, including the coefficient. Preserve the original nonzero restrictions.",
          "worked_example": {
            "problem": "Simplify $15x^{-3}y^2/(5x^4y^{-1})$ with positive exponents, for $x,y\\ne0$.",
            "steps": [
              "Reduce coefficients: $15/5=3$.",
              "For $x$, subtract exponents: $-3-4=-7$.",
              "For $y$, subtract exponents: $2-(-1)=3$.",
              "Rewrite $x^{-7}$ as $1/x^7$, giving $3y^3/x^7$."
            ]
          }
        }
      }
    }
  ]
}
