      "answer_kind": {
        "anyOf": [
          {
            "$ref": "#/$defs/AnswerKind"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "assisted": {
        "default": false,
        "title": "Assisted",
        "type": "boolean"
      },
      "attempt_id": {
        "title": "Attempt Id",
        "type": "string"
      },
      "correct": {
        "title": "Correct",
        "type": "boolean"
      },
      "error_tags": {
        "items": {
          "type": "string"
        },
        "title": "Error Tags",
        "type": "array"
      },
      "given_answer": {
        "title": "Given Answer",
        "type": "string"
      },
      "grader_note": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Grader Note"
      },
      "kp": {
        "anyOf": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Kp"
      },
      "problem": {
        "$ref": "#/$defs/AttemptProblem"
      },
      "secs": {
        "minimum": 0,
        "title": "Secs",
        "type": "integer"
      },
      "session": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Session"
      },
      "task_id": {
        "title": "Task Id",
        "type": "string"
      },
      "task_type": {
        "$ref": "#/$defs/TaskType"
      },
      "topic": {
        "minLength": 1,
        "title": "Topic",
        "type": "string"
      },
      "ts": {
        "format": "date-time",
        "title": "Ts",
        "type": "string"
      },
      "type": {
        "const": "attempt",
        "default": "attempt",
        "title": "Type",
        "type": "string"
      },
      "v": {
        "default": 1,
        "title": "V",
        "type": "integer"
      },
      "work": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Work"
      },
      "work_quality": {
        "$ref": "#/$defs/WorkQuality"
      }
    },
    "required": [
      "ts",
      "attempt_id",
      "task_id",
      "topic",
      "task_type",
      "problem",
      "given_answer",
      "correct",
      "secs",
