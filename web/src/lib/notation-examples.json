{
 "sections": [
  {
   "name": "Numbers and fractions",
   "rows": [
    {
     "want": "three quarters",
     "type": "3/4",
     "latex": "\\frac{3}{4}"
    },
    {
     "want": "the same fraction, large form",
     "type": "3/4",
     "latex": "\\dfrac{3}{4}"
    },
    {
     "want": "a mixed number",
     "type": "4 2/5",
     "latex": "4\\frac{2}{5}"
    },
    {
     "want": "a decimal",
     "type": "0.75",
     "latex": "0.75"
    },
    {
     "want": "a long number with spaces",
     "type": "12 345",
     "latex": "12\\,345"
    },
    {
     "want": "a negative number",
     "type": "-7",
     "latex": "-7"
    },
    {
     "want": "a negative fraction",
     "type": "-2/3",
     "latex": "-\\frac{2}{3}"
    },
    {
     "want": "plus or minus",
     "type": "x = ±3",
     "latex": "x = \\pm 3",
     "contract": {
      "kind": "set"
     },
     "key": "-3, 3"
    },
    {
     "want": "a sum",
     "type": "2x+1",
     "latex": "2x+1"
    },
    {
     "want": "a product",
     "type": "3*4",
     "latex": "3\\cdot 4"
    }
   ]
  },
  {
   "name": "Powers and roots",
   "rows": [
    {
     "want": "x squared",
     "type": "x^2",
     "latex": "x^{2}"
    },
    {
     "want": "a power of 10",
     "type": "10^3",
     "latex": "10^{3}"
    },
    {
     "want": "a fraction power",
     "type": "x^(1/2)",
     "latex": "x^{\\frac{1}{2}}"
    },
    {
     "want": "a negative power",
     "type": "x^-1",
     "latex": "x^{-1}"
    },
    {
     "want": "square root of 2",
     "type": "sqrt(2)",
     "latex": "\\sqrt{2}"
    },
    {
     "want": "square root with the symbol",
     "type": "√(2)",
     "latex": "\\sqrt{2}"
    },
    {
     "want": "two times a root",
     "type": "2sqrt(3)",
     "latex": "2\\sqrt{3}"
    },
    {
     "want": "fifth root of y",
     "type": "root(5, y)",
     "latex": "\\sqrt[5]{y}"
    },
    {
     "want": "cube root of 8",
     "type": "root(3, 8)",
     "latex": "\\sqrt[3]{8}"
    }
   ]
  },
  {
   "name": "Constants and Greek letters",
   "rows": [
    {
     "want": "pi",
     "type": "pi",
     "latex": "\\pi"
    },
    {
     "want": "pi with the key",
     "type": "π",
     "latex": "\\pi"
    },
    {
     "want": "two pi",
     "type": "2pi",
     "latex": "2\\pi"
    },
    {
     "want": "the number e",
     "type": "e",
     "latex": "e"
    },
    {
     "want": "infinity",
     "type": "infinity",
     "latex": "\\infty"
    },
    {
     "want": "infinity with the key",
     "type": "∞",
     "latex": "\\infty"
    },
    {
     "want": "theta",
     "type": "theta",
     "latex": "\\theta"
    },
    {
     "want": "alpha",
     "type": "alpha",
     "latex": "\\alpha"
    }
   ]
  },
  {
   "name": "Functions and logs",
   "rows": [
    {
     "want": "natural log",
     "type": "ln(x)",
     "latex": "\\ln(x)"
    },
    {
     "want": "log base 10",
     "type": "log(x)",
     "latex": "\\log(x)"
    },
    {
     "want": "log base 2 of 8",
     "type": "log_2(8)",
     "latex": "\\log_{2}(8)"
    },
    {
     "want": "absolute value",
     "type": "abs(x)",
     "latex": "\\left|x\\right|"
    },
    {
     "want": "absolute value with bars",
     "type": "|x|",
     "latex": "|x|"
    },
    {
     "want": "exponential",
     "type": "e^x",
     "latex": "e^{x}"
    },
    {
     "want": "factorial",
     "type": "5!",
     "latex": "5!"
    }
   ]
  },
  {
   "name": "Trigonometry and degrees",
   "rows": [
    {
     "want": "sine of pi over 6",
     "type": "sin(pi/6)",
     "latex": "\\sin\\left(\\frac{\\pi}{6}\\right)"
    },
    {
     "want": "cosine of 60 degrees",
     "type": "cos(60°)",
     "latex": "\\cos(60^\\circ)"
    },
    {
     "want": "tangent of x",
     "type": "tan(x)",
     "latex": "\\tan(x)"
    },
    {
     "want": "inverse sine",
     "type": "arcsin(x)",
     "latex": "\\arcsin(x)"
    },
    {
     "want": "inverse sine, short",
     "type": "asin(x)",
     "latex": "\\arcsin(x)"
    },
    {
     "want": "inverse tangent as a power",
     "type": "tan^-1(x)",
     "latex": "\\tan^{-1}(x)"
    },
    {
     "want": "sine squared",
     "type": "sin(x)^2",
     "latex": "\\sin^{2}(x)"
    },
    {
     "want": "an angle",
     "type": "90°",
     "latex": "90^\\circ"
    }
   ]
  },
  {
   "name": "Inequalities and intervals",
   "rows": [
    {
     "want": "less than or equal",
     "type": "x <= 3",
     "latex": "x \\le 3",
     "contract": {
      "kind": "inequality_union"
     }
    },
    {
     "want": "less than or equal, with the key",
     "type": "x ≤ 3",
     "latex": "x \\leq 3",
     "contract": {
      "kind": "inequality_union"
     }
    },
    {
     "want": "greater than or equal",
     "type": "x >= 3",
     "latex": "x \\ge 3",
     "contract": {
      "kind": "inequality_union"
     }
    },
    {
     "want": "between two numbers",
     "type": "-2 < x < 5",
     "latex": "-2 < x < 5",
     "contract": {
      "kind": "inequality_union"
     }
    },
    {
     "want": "an interval",
     "type": "(-inf, 4]",
     "latex": "(-\\infty, 4]",
     "contract": {
      "kind": "inequality_union"
     }
    },
    {
     "want": "two intervals joined",
     "type": "(-inf, 1) U (2, inf)",
     "latex": "(-\\infty, 1) \\cup (2, \\infty)",
     "contract": {
      "kind": "inequality_union"
     }
    },
    {
     "want": "either of two conditions",
     "type": "x > 1 or x < -1",
     "latex": "x > 1 \\text{ or } x < -1",
     "contract": {
      "kind": "inequality_union"
     }
    },
    {
     "want": "not equal",
     "type": "x != 3",
     "latex": "x \\ne 3",
     "contract": {
      "kind": "inequality_union"
     }
    },
    {
     "want": "not equal, with the key",
     "type": "x ≠ 3",
     "latex": "x \\neq 3",
     "contract": {
      "kind": "inequality_union"
     }
    }
   ]
  },
  {
   "name": "Sets, lists and points",
   "rows": [
    {
     "want": "a set",
     "type": "{1, 2, 3}",
     "latex": "\\{1, 2, 3\\}",
     "contract": {
      "kind": "set"
     }
    },
    {
     "want": "a list",
     "type": "1, 2, 3",
     "latex": "1, 2, 3",
     "contract": {
      "kind": "list",
      "ordered": true,
      "member": {
       "kind": "exact"
      }
     }
    },
    {
     "want": "a point",
     "type": "(2, -3)",
     "latex": "(2, -3)",
     "contract": {
      "kind": "coordinates",
      "arity": 2
     }
    },
    {
     "want": "two values named",
     "type": "x = 2, y = 3",
     "latex": "x = 2, y = 3"
    },
    {
     "want": "numbers in order",
     "type": "3 < 5 < 8",
     "latex": "3 < 5 < 8",
     "contract": {
      "kind": "ascending_chain"
     }
    }
   ]
  },
  {
   "name": "Vectors and matrices",
   "rows": [
    {
     "want": "a vector",
     "type": "(1, 2, 3)",
     "latex": "(1, 2, 3)",
     "contract": {
      "kind": "coordinates",
      "arity": 3
     }
    },
    {
     "want": "a vector in angle brackets",
     "type": "<1, 2>",
     "latex": "\\langle 1, 2 \\rangle",
     "contract": {
      "kind": "coordinates",
      "arity": 2
     },
     "key": "(1, 2)"
    },
    {
     "want": "a matrix",
     "type": "[[1,2],[3,4]]",
     "latex": "\\begin{pmatrix}1&2\\\\3&4\\end{pmatrix}",
     "contract": {
      "kind": "matrix",
      "rows": 2,
      "cols": 2
     }
    }
   ]
  },
  {
   "name": "Units and money",
   "rows": [
    {
     "want": "a length",
     "type": "3 m",
     "latex": "3\\ \\text{m}",
     "contract": {
      "kind": "unit",
      "quantity": "length",
      "unit": "m"
     }
    },
    {
     "want": "a speed",
     "type": "18 km/h",
     "latex": "18\\ \\text{km/h}",
     "contract": {
      "kind": "unit",
      "quantity": "speed",
      "unit": "km/h"
     }
    },
    {
     "want": "money",
     "type": "$12,700",
     "latex": "\\$12{,}700"
    },
    {
     "want": "a time",
     "type": "4 hours 30 minutes",
     "latex": "4\\text{ hours }30\\text{ minutes}",
     "contract": {
      "kind": "unit",
      "quantity": "time",
      "unit": "h"
     },
     "key": "4.5 h"
    },
    {
     "want": "a temperature",
     "type": "36 C",
     "latex": "36\\ \\text{C}"
    }
   ]
  },
  {
   "name": "Answers in words",
   "rows": [
    {
     "want": "no solution",
     "type": "no solution",
     "latex": "\\text{no solution}"
    },
    {
     "want": "yes",
     "type": "yes",
     "latex": "\\text{yes}",
     "contract": {
      "kind": "label",
      "options": [
       [
        "yes"
       ],
       [
        "no"
       ]
      ]
     }
    },
    {
     "want": "a series that diverges",
     "type": "diverges",
     "latex": "\\text{diverges}",
     "contract": {
      "kind": "label",
      "options": [
       [
        "diverges"
       ],
       [
        "converges"
       ]
      ]
     }
    },
    {
     "want": "quotient and remainder",
     "type": "x + 2 remainder 3",
     "latex": "x + 2 \\text{ remainder } 3",
     "contract": {
      "kind": "polynomial_division",
      "divisor": "x - 1"
     }
    }
   ]
  }
 ]
}