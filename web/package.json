{
  "name": "cadus-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test scripts e2e *.ts *.config.js",
    "types": "tsc --noEmit",
    "invariants": "node scripts/check-invariants.mjs",
    "csp": "node scripts/check-bundle-csp.mjs",
    "selftest": "node scripts/check-invariants.mjs --selftest && node scripts/check-bundle-csp.mjs --selftest",
    "check": "npm run selftest && npm run lint && npm run types && npm run test && npm run invariants && npm run build && npm run csp"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "katex": "0.17.0",
    "msw": "^2.12.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  }
}
