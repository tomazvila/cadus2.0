// The PRODUCTION typecheck: `src/` only.
//
// `tsconfig.json` covers src + test + the config files at the root. The Docker build stage
// copies `web/` and runs `npm run build`, and a production build must typecheck what it
// EMITS — not the test tree, and not the Node config files.
//
// `npm run types` still checks everything, tests included, and `npm run check` runs both.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Vitest's globals are not in scope for production code. An `import { it } from
    // 'vitest'` that strays into `src/` must fail the build, not ship.
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      // The vendored library, typed for production. Under `tsconfig.json` this same
      // specifier maps to the test double instead. `paths` REPLACES the inherited object,
      // so `@/*` has to be repeated here.
      "/vendor/cytoscape/cytoscape.esm.min.mjs": ["./src/vendor-cytoscape.d.ts"]
    }
  },
  "include": ["src"]
}
