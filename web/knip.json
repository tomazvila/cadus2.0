{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.tsx", "test/**/*.test.{ts,tsx}", "test/setup.ts", "scripts/*.mjs", "e2e/*.mjs", "*.config.{js,ts}", "vendor-tags.ts"],
  "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "scripts/**/*.mjs", "e2e/*.mjs", "*.ts", "*.config.js"],
  "ignore": ["e2e/work/**", "e2e/shots/**", "dist/**"],
  "ignoreDependencies": ["katex", "@vitest/coverage-v8", "@stryker-mutator/vitest-runner"],
  "ignoreBinaries": ["cargo"],
  "rules": { "duplicates": "error", "exports": "error", "types": "error", "files": "error", "dependencies": "error", "devDependencies": "error", "unlisted": "error", "unresolved": "error", "nsExports": "error", "nsTypes": "error", "enumMembers": "error", "classMembers": "error" }
}
