{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/index.tsx", "test/**/*.test.{ts,tsx}", "scripts/*.mjs", "*.config.{js,ts}", "vendor-tags.ts"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "scripts/**/*.mjs", "*.ts", "*.config.js"]
    },
    "e2e": {
      "entry": ["*.mjs"],
      "project": ["*.mjs"]
    }
  },
  "rules": { "duplicates": "error", "exports": "error", "types": "error", "files": "error", "dependencies": "error", "devDependencies": "error", "unlisted": "error", "unresolved": "error", "nsExports": "error", "nsTypes": "error", "enumMembers": "error" }
}
